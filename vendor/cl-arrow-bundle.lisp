;;; buffer.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Raw byte buffers and little-endian numeric access.  Arrow stores all
;;; numeric data little-endian; buffers are conceptually contiguous memory.

(in-package #:cl-arrow)

(deftype octet () '(unsigned-byte 8))
(deftype octet-vector (&optional (n '*)) `(simple-array octet (,n)))

(declaim (inline make-octet-vector))
(defun make-octet-vector (n &key (initial-element 0))
  "Allocate a fresh simple (unsigned-byte 8) vector of length N."
  (make-array n :element-type 'octet :initial-element initial-element))

(defun octet-vector-from (sequence)
  "Coerce SEQUENCE (a list or vector of octets) to an OCTET-VECTOR."
  (let* ((n (length sequence))
         (v (make-octet-vector n)))
    (etypecase sequence
      (list (loop for i from 0 for x in sequence do (setf (aref v i) x)))
      (sequence (dotimes (i n) (setf (aref v i) (elt sequence i)))))
    v))

;;; A BUFFER is a lightweight wrapper over an octet vector.  We keep the
;;; wrapper so that a buffer can carry a fill pointer / logical length that
;;; may be smaller than the underlying (possibly padded) allocation, and so
;;; buffers are distinguishable from arbitrary vectors.

(defstruct (buffer (:constructor %make-buffer (bytes length))
                   (:predicate buffer-p))
  (bytes (make-octet-vector 0) :type octet-vector)
  (length 0 :type fixnum))

(defun make-buffer (n-or-bytes &key length)
  "Make a BUFFER.  If N-OR-BYTES is an integer, allocate that many zeroed
bytes.  If it is an octet vector, wrap it (copying to a simple vector when
needed).  LENGTH overrides the logical length."
  (etypecase n-or-bytes
    (integer (%make-buffer (make-octet-vector n-or-bytes)
                           (or length n-or-bytes)))
    (vector (let ((bytes (if (typep n-or-bytes 'octet-vector)
                             n-or-bytes
                             (octet-vector-from n-or-bytes))))
              (%make-buffer bytes (or length (length bytes)))))))

(declaim (inline buffer-ref))
(defun buffer-ref (buffer i)
  (aref (buffer-bytes buffer) i))

(defun (setf buffer-ref) (value buffer i)
  (setf (aref (buffer-bytes buffer) i) value))

(defun buffer-copy (buffer)
  "Return a deep copy of BUFFER."
  (%make-buffer (copy-seq (buffer-bytes buffer)) (buffer-length buffer)))

(defun buffer-slice (buffer start &optional end)
  "Return a fresh buffer holding bytes [START,END) of BUFFER."
  (let* ((end (or end (buffer-length buffer)))
         (n (- end start))
         (out (make-octet-vector n))
         (src (buffer-bytes buffer)))
    (dotimes (i n) (setf (aref out i) (aref src (+ start i))))
    (%make-buffer out n)))

;;; ---------------------------------------------------------------------------
;;; Little-endian integer access.  Callers pass either a BUFFER or a raw
;;; OCTET-VECTOR; we normalize to the underlying vector.

(declaim (inline %bytes))
(defun %bytes (buf)
  (if (buffer-p buf) (buffer-bytes buf) buf))

(macrolet ((defread (name nbytes)
             `(progn
                (defun ,name (buf offset)
                  (let ((b (%bytes buf)) (acc 0))
                    (declare (type (integer 0) acc))
                    (dotimes (i ,nbytes acc)
                      (setf acc (logior acc (ash (aref b (+ offset i)) (* 8 i)))))))))
           (defwrite (name nbytes)
             `(defun ,name (buf offset value)
                (let ((b (%bytes buf)) (v (logand value ,(1- (ash 1 (* 8 nbytes))))))
                  (dotimes (i ,nbytes value)
                    (setf (aref b (+ offset i)) (logand (ash v (* -8 i)) #xff)))))))
  (defread read-u8 1)  (defwrite write-u8 1)
  (defread read-u16 2) (defwrite write-u16 2)
  (defread read-u32 4) (defwrite write-u32 4)
  (defread read-u64 8) (defwrite write-u64 8))

(defmacro %def-signed (rname wname ubits)
  (let ((limit (ash 1 (1- ubits)))
        (modulus (ash 1 ubits))
        (uread (find-symbol (format nil "READ-U~D" ubits) :cl-arrow))
        (uwrite (find-symbol (format nil "WRITE-U~D" ubits) :cl-arrow)))
    `(progn
       (defun ,rname (buf offset)
         (let ((u (,uread buf offset)))
           (if (>= u ,limit) (- u ,modulus) u)))
       (defun ,wname (buf offset value)
         (,uwrite buf offset (logand value ,(1- modulus)))))))

(%def-signed read-i8  write-i8  8)
(%def-signed read-i16 write-i16 16)
(%def-signed read-i32 write-i32 32)
(%def-signed read-i64 write-i64 64)

;;; ---------------------------------------------------------------------------
;;; Portable IEEE-754 <-> bit-pattern conversion (no implementation internals).

(defun %bits->float (bits mantissa-bits exponent-bits)
  (let* ((total (+ 1 mantissa-bits exponent-bits))
         (sign (if (logbitp (1- total) bits) -1 1))
         (exp (ldb (byte exponent-bits mantissa-bits) bits))
         (frac (ldb (byte mantissa-bits 0) bits))
         (bias (1- (ash 1 (1- exponent-bits))))
         (max-exp (1- (ash 1 exponent-bits))))
    (cond
      ((= exp max-exp)
       ;; Non-finite values decode to keyword sentinels, since NaN/Inf are not
       ;; portably representable as CL floats (see R3).
       (if (zerop frac) (if (minusp sign) :-inf :+inf) :nan))
      ((zerop exp)                      ; zero or subnormal
       (if (zerop frac)
           (* sign 0d0)
           (* sign (scale-float (coerce frac 'double-float)
                                (- (+ (- bias) 1) mantissa-bits)))))
      (t (* sign (scale-float (coerce (logior (ash 1 mantissa-bits) frac) 'double-float)
                              (- exp bias mantissa-bits)))))))

(defun bits->single (bits) (%bits->float bits 23 8))
(defun bits->double (bits) (%bits->float bits 52 11))

(defun %nonfinite-bits (kind mantissa-bits exponent-bits)
  "Bit pattern for a non-finite KIND (:+inf :-inf :nan) in the given format."
  (let* ((total (+ mantissa-bits exponent-bits))
         (inf (ash (1- (ash 1 exponent-bits)) mantissa-bits)))
    (ecase kind
      ((:+inf :inf) inf)
      (:-inf (logior (ash 1 total) inf))
      (:nan (logior inf (ash 1 (1- mantissa-bits)))))))    ; quiet NaN

(defun %nonfinite-float-p (x)
  "Best-effort classification of a CL float X as :+inf/:-inf/:nan, else NIL.
Uses only ordered comparisons and guards NaN detection so it never traps."
  (when (floatp x)
    (cond ((> x most-positive-double-float) :+inf)
          ((< x most-negative-double-float) :-inf)
          ((ignore-errors (/= x x)) :nan))))

(defun %float->bits (x mantissa-bits exponent-bits)
  "Encode X to a MANTISSA-BITS+EXPONENT-BITS IEEE-754 bit pattern.  X is a real
number or a non-finite sentinel keyword (:+inf :inf :-inf :nan)."
  (let ((kind (cond ((keywordp x) x) (t (%nonfinite-float-p x)))))
    (when kind (return-from %float->bits (%nonfinite-bits kind mantissa-bits exponent-bits))))
  (let* ((x (coerce x 'double-float))
         (bias (1- (ash 1 (1- exponent-bits))))
         (max-exp (1- (ash 1 exponent-bits)))
         (sign (if (minusp (float-sign x)) 1 0)))
    (if (zerop x)
        (ash sign (+ mantissa-bits exponent-bits))
        (multiple-value-bind (signif expo s) (integer-decode-float x)
          (declare (ignore s))
          (let* ((mag (abs x))
                 (e (+ expo (integer-length signif) -1))   ; mag in [2^e, 2^(e+1))
                 (biased (+ e bias)))
            (cond
              ((>= biased max-exp)      ; overflow -> +/-Inf
               (logior (ash sign (+ mantissa-bits exponent-bits))
                       (ash max-exp mantissa-bits)))
              ((<= biased 0)            ; subnormal / underflow
               (let ((frac (round (* mag (scale-float 1d0 (- (- bias) 1 (- mantissa-bits)))))))
                 (logior (ash sign (+ mantissa-bits exponent-bits))
                         (ldb (byte mantissa-bits 0) frac))))
              (t
               (let* ((scaled (round (scale-float mag (- mantissa-bits e))))
                      (frac (ldb (byte mantissa-bits 0) scaled)))
                 (when (logbitp (1+ mantissa-bits) scaled)   ; rounded up to 2^k
                   (setf biased (1+ biased) frac 0))
                 (logior (ash sign (+ mantissa-bits exponent-bits))
                         (ash biased mantissa-bits)
                         frac)))))))))

(defun single->bits (x) (%float->bits x 23 8))
(defun double->bits (x) (%float->bits x 52 11))

(defun read-f32 (buf offset)
  (let ((v (bits->single (read-u32 buf offset))))
    (if (keywordp v) v (coerce v 'single-float))))
(defun read-f64 (buf offset)
  (bits->double (read-u64 buf offset)))
(defun write-f32 (buf offset value)
  (write-u32 buf offset (single->bits value)))
(defun write-f64 (buf offset value)
  (write-u64 buf offset (double->bits value)))


(defclass int-type (data-type)
  ((bit-width :initarg :bit-width :reader int-bit-width)
   (signed :initarg :signed :reader int-signed-p)))
(defmethod type-id ((ty int-type)) :int)
(defmethod type-name ((ty int-type))
  (format nil "~:[u~;~]int~D" (int-signed-p ty) (int-bit-width ty)))
(defmethod type-num-buffers ((ty int-type)) 2)
(defmethod fixed-width-p ((ty int-type)) t)
(defmethod type-bit-width ((ty int-type)) (int-bit-width ty))
(defmethod type-equal ((a int-type) (b int-type))
  (and (= (int-bit-width a) (int-bit-width b))
       (eq (int-signed-p a) (int-signed-p b))))
(defun int-type (bit-width &key (signed t))
  (make-instance 'int-type :bit-width bit-width :signed (and signed t)))

(defclass floating-point-type (data-type)
  ((precision :initarg :precision :reader floating-point-precision))) ; :half :single :double
(defmethod type-id ((ty floating-point-type)) :floating-point)
(defmethod type-name ((ty floating-point-type))
  (ecase (floating-point-precision ty) (:half "halffloat") (:single "float") (:double "double")))
(defmethod type-num-buffers ((ty floating-point-type)) 2)
(defmethod fixed-width-p ((ty floating-point-type)) t)
(defmethod type-bit-width ((ty floating-point-type))
  (ecase (floating-point-precision ty) (:half 16) (:single 32) (:double 64)))
(defmethod type-equal ((a floating-point-type) (b floating-point-type))
  (eq (floating-point-precision a) (floating-point-precision b)))
(defun floating-point-type (precision)
  (make-instance 'floating-point-type :precision precision))


(defmethod type-equal ((a time-type) (b time-type))
  (and (eq (time-unit a) (time-unit b)) (= (time-bit-width a) (time-bit-width b))))
(defun time-type (unit &optional bit-width)
  (make-instance 'time-type :unit unit
                 :bit-width (or bit-width
                                (ecase unit ((:second :millisecond) 32)
                                       ((:microsecond :nanosecond) 64)))))

(defclass timestamp-type (data-type)
  ((unit :initarg :unit :reader timestamp-unit)
   (timezone :initarg :timezone :initform nil :reader timestamp-timezone)))
(defmethod type-id ((ty timestamp-type)) :timestamp)
(defmethod type-name ((ty timestamp-type))
  (format nil "timestamp[~(~A~)~@[, tz=~A~]]" (timestamp-unit ty) (timestamp-timezone ty)))
(defmethod type-num-buffers ((ty timestamp-type)) 2)
(defmethod fixed-width-p ((ty timestamp-type)) t)
(defmethod type-bit-width ((ty timestamp-type)) 64)
(defmethod type-equal ((a timestamp-type) (b timestamp-type))
  (and (eq (timestamp-unit a) (timestamp-unit b))
       (equal (timestamp-timezone a) (timestamp-timezone b))))
(defun timestamp-type (unit &key timezone)
  (make-instance 'timestamp-type :unit unit :timezone timezone))

(defclass duration-type (data-type)
  ((unit :initarg :unit :reader duration-unit)))
(defmethod type-id ((ty duration-type)) :duration)
(defmethod type-name ((ty duration-type)) (format nil "duration[~(~A~)]" (duration-unit ty)))
(defmethod type-num-buffers ((ty duration-type)) 2)
(defmethod fixed-width-p ((ty duration-type)) t)
(defmethod type-bit-width ((ty duration-type)) 64)
(defmethod type-equal ((a duration-type) (b duration-type)) (eq (duration-unit a) (duration-unit b)))
(defun duration-type (unit) (make-instance 'duration-type :unit unit))

(defclass decimal-type (data-type)
  ((precision :initarg :precision :reader decimal-precision)
   (scale :initarg :scale :reader decimal-scale)
   (bit-width :initarg :bit-width :initform 128 :reader decimal-bit-width)))
(defmethod type-id ((ty decimal-type)) :decimal)
(defmethod type-name ((ty decimal-type))
  (format nil "decimal~D[~D,~D]" (decimal-bit-width ty)
          (decimal-precision ty) (decimal-scale ty)))
(defmethod type-num-buffers ((ty decimal-type)) 2)
(defmethod fixed-width-p ((ty decimal-type)) t)
(defmethod type-bit-width ((ty decimal-type)) (decimal-bit-width ty))
(defmethod type-equal ((a decimal-type) (b decimal-type))
  (and (= (decimal-precision a) (decimal-precision b))
       (= (decimal-scale a) (decimal-scale b))
       (= (decimal-bit-width a) (decimal-bit-width b))))
(defun decimal-type (precision scale &key (bit-width 128))
  (make-instance 'decimal-type :precision precision :scale scale :bit-width bit-width))

;;; ---------------------------------------------------------------------------
;;; Nested types.

(defun %item-field (type &key (name "item") (nullable t))
  (if (field-p type) type (make-field name type :nullable nullable)))

(defclass list-type (data-type)
  ((value-field :initarg :value-field :reader list-value-field)))
(defmethod type-id ((ty list-type)) :list)
(defmethod type-name ((ty list-type)) "list")
(defmethod type-num-buffers ((ty list-type)) 2)   ; validity + offsets
(defmethod offset-bit-width ((ty list-type)) 32)
(defmethod type-children ((ty list-type)) (list (list-value-field ty)))
(defmethod type-equal ((a list-type) (b list-type))
  (and (eq (type-id a) (type-id b))
       (field-equal (list-value-field a) (list-value-field b))))
(defun list-type (value-type &key (name "item") (nullable t))
  (make-instance 'list-type :value-field (%item-field value-type :name name :nullable nullable)))

(defclass large-list-type (list-type) ())
(defmethod type-id ((ty large-list-type)) :large-list)
(defmethod type-name ((ty large-list-type)) "large_list")
(defmethod offset-bit-width ((ty large-list-type)) 64)
(defun large-list-type (value-type &key (name "item") (nullable t))
  (make-instance 'large-list-type :value-field (%item-field value-type :name name :nullable nullable)))

(defclass fixed-size-list-type (data-type)
  ((value-field :initarg :value-field :reader list-value-field)
   (list-size :initarg :list-size :reader fixed-size-list-size)))
(defmethod type-id ((ty fixed-size-list-type)) :fixed-size-list)
(defmethod type-name ((ty fixed-size-list-type))
  (format nil "fixed_size_list[~D]" (fixed-size-list-size ty)))
(defmethod type-num-buffers ((ty fixed-size-list-type)) 1) ; validity only
(defmethod type-children ((ty fixed-size-list-type)) (list (list-value-field ty)))
(defmethod type-equal ((a fixed-size-list-type) (b fixed-size-list-type))
  (and (= (fixed-size-list-size a) (fixed-size-list-size b))
       (field-equal (list-value-field a) (list-value-field b))))
(defun fixed-size-list-type (value-type list-size &key (name "item") (nullable t))
  (make-instance 'fixed-size-list-type
                 :value-field (%item-field value-type :name name :nullable nullable)
                 :list-size list-size))

(defclass struct-type (data-type)
  ((fields :initarg :fields :reader struct-fields)))
(defmethod type-id ((ty struct-type)) :struct)
(defmethod type-name ((ty struct-type)) "struct")
(defmethod type-num-buffers ((ty struct-type)) 1) ; validity only
(defmethod type-children ((ty struct-type)) (struct-fields ty))
(defmethod type-equal ((a struct-type) (b struct-type))
  (fields-equal (struct-fields a) (struct-fields b)))
(defun struct-type (fields) (make-instance 'struct-type :fields fields))

(defclass map-type (data-type)
  ((entries-field :initarg :entries-field :reader map-entries-field)
   (keys-sorted :initarg :keys-sorted :initform nil :reader map-keys-sorted-p)))
(defmethod type-id ((ty map-type)) :map)
(defmethod type-name ((ty map-type)) "map")
(defmethod type-num-buffers ((ty map-type)) 2)  ; validity + offsets
(defmethod offset-bit-width ((ty map-type)) 32)
(defmethod type-children ((ty map-type)) (list (map-entries-field ty)))
(defmethod type-equal ((a map-type) (b map-type))
  (and (eq (map-keys-sorted-p a) (map-keys-sorted-p b))
       (field-equal (map-entries-field a) (map-entries-field b))))
(defun map-type (key-type item-type &key keys-sorted (item-nullable t))
  (let ((entries (struct-type (list (make-field "key" key-type :nullable nil)
                                    (make-field "value" item-type :nullable item-nullable)))))
    (make-instance 'map-type
                   :entries-field (make-field "entries" entries :nullable nil)
                   :keys-sorted keys-sorted)))

(defclass union-type (data-type)
  ((mode :initarg :mode :reader union-mode)          ; :sparse | :dense
   (fields :initarg :fields :reader struct-fields)
   (type-ids :initarg :type-ids :reader union-type-ids)))
(defmethod type-id ((ty union-type)) :union)
(defmethod type-name ((ty union-type)) (format nil "~(~A~)_union" (union-mode ty)))
(defmethod type-num-buffers ((ty union-type)) (ecase (union-mode ty) (:sparse 1) (:dense 2)))
(defmethod type-children ((ty union-type)) (struct-fields ty))
(defmethod type-equal ((a union-type) (b union-type))
  (and (eq (union-mode a) (union-mode b))
       (equal (union-type-ids a) (union-type-ids b))
       (fields-equal (struct-fields a) (struct-fields b))))
(defun union-type (fields &key (mode :sparse) type-ids)
  (make-instance 'union-type :mode mode :fields fields
                 :type-ids (or type-ids (loop for i below (length fields) collect i))))

(defclass dictionary-type (data-type)
  ((index-type :initarg :index-type :reader dictionary-index-type)
   (value-type :initarg :value-type :reader dictionary-value-type)
   (ordered :initarg :ordered :initform nil :reader dictionary-ordered-p)
   ;; IPC dictionary id, assigned/decoded during serialization (else NIL).
   (id :initarg :id :initform nil :accessor dictionary-type-id)))
(defmethod type-id ((ty dictionary-type)) :dictionary)
(defmethod type-name ((ty dictionary-type))
  (format nil "dictionary<~A, ~A>"
          (type-name (dictionary-index-type ty)) (type-name (dictionary-value-type ty))))
;; Physically an array of dictionary type stores index buffers.
(defmethod type-num-buffers ((ty dictionary-type))
  (type-num-buffers (dictionary-index-type ty)))
(defmethod fixed-width-p ((ty dictionary-type)) t)
(defmethod type-bit-width ((ty dictionary-type)) (type-bit-width (dictionary-index-type ty)))
(defmethod type-equal ((a dictionary-type) (b dictionary-type))
  (and (eq (dictionary-ordered-p a) (dictionary-ordered-p b))
       (type-equal (dictionary-index-type a) (dictionary-index-type b))
       (type-equal (dictionary-value-type a) (dictionary-value-type b))))
(defun dictionary-type (index-type value-type &key ordered)
  (make-instance 'dictionary-type :index-type index-type :value-type value-type :ordered ordered))

;;; ---------------------------------------------------------------------------
;;; Ready-made singletons for the common cases.

(defparameter *null*   (make-instance 'null-type))
(defparameter *bool*   (make-instance 'bool-type))
(defparameter *int8*   (int-type 8))
(defparameter *int16*  (int-type 16))
(defparameter *int32*  (int-type 32))
(defparameter *int64*  (int-type 64))
(defparameter *uint8*  (int-type 8  :signed nil))
(defparameter *uint16* (int-type 16 :signed nil))
(defparameter *uint32* (int-type 32 :signed nil))
(defparameter *uint64* (int-type 64 :signed nil))
(defparameter *float16* (floating-point-type :half))
(defparameter *float32* (floating-point-type :single))
(defparameter *float64* (floating-point-type :double))
(defparameter *utf8*         (make-instance 'utf8-type))
(defparameter *binary*       (make-instance 'binary-type))
(defparameter *large-utf8*   (make-instance 'large-utf8-type))
(defparameter *large-binary* (make-instance 'large-binary-type))
;;; field.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Schemas.  (FIELD itself is defined in datatype.lisp because nested types
;;; refer to fields.)

(in-package #:cl-arrow)

(defstruct (schema (:constructor %make-schema) (:copier nil) (:predicate schema-p))
  (fields '() :type list)               ; list of FIELD
  (metadata nil))                       ; list of (key-string . value-string)

(defun make-schema (fields &key metadata)
  "Construct a schema from a list of FIELDs."
  (%make-schema :fields (coerce fields 'list) :metadata metadata))

(defun schema-field-index (schema name)
  "Index of the first field named NAME, or NIL."
  (position name (schema-fields schema) :key #'field-name :test #'string=))

(defun schema-field (schema name-or-index)
  "Look up a field by NAME (string) or INDEX (integer)."
  (etypecase name-or-index
    (integer (nth name-or-index (schema-fields schema)))
    (string (let ((i (schema-field-index schema name-or-index)))
              (and i (nth i (schema-fields schema)))))))

(defmethod print-object ((s schema) stream)
  (print-unreadable-object (s stream :type t)
    (format stream "~{~A~^, ~}"
            (mapcar (lambda (f)
                      (format nil "~A: ~A" (field-name f) (type-name (field-type f))))
                    (schema-fields s)))))

(defmethod print-object ((f field) stream)
  (print-unreadable-object (f stream :type t)
    (format stream "~A: ~A~:[~; not null~]"
            (field-name f) (type-name (field-type f)) (not (field-nullable f)))))
;;; array.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Columnar arrays.  ARRAY-DATA is the physical container (type, logical
;;; length, offset, buffers, children, optional dictionary) shared with the
;;; IPC layer.  Logical element access is provided by ARRAY-REF, which
;;; interprets the buffers according to the type.

(in-package #:cl-arrow)

;;; ---------------------------------------------------------------------------
;;; Minimal zero-dependency UTF-8 codec.

(defun utf8-encode (string)
  "Encode STRING to a fresh octet-vector of UTF-8 bytes."
  (let ((out (make-array (length string) :element-type 'octet
                                         :adjustable t :fill-pointer 0)))
    (loop for ch across string
          for cp = (char-code ch) do
            (cond
              ((< cp #x80) (vector-push-extend cp out))
              ((< cp #x800)
               (vector-push-extend (logior #xC0 (ash cp -6)) out)
               (vector-push-extend (logior #x80 (logand cp #x3F)) out))
              ((< cp #x10000)
               (vector-push-extend (logior #xE0 (ash cp -12)) out)
               (vector-push-extend (logior #x80 (logand (ash cp -6) #x3F)) out)
               (vector-push-extend (logior #x80 (logand cp #x3F)) out))
              (t
               (vector-push-extend (logior #xF0 (ash cp -18)) out)
               (vector-push-extend (logior #x80 (logand (ash cp -12) #x3F)) out)
               (vector-push-extend (logior #x80 (logand (ash cp -6) #x3F)) out)
               (vector-push-extend (logior #x80 (logand cp #x3F)) out))))
    (octet-vector-from out)))

(defun utf8-decode (bytes start end)
  "Decode UTF-8 octets in [START,END) of BYTES to a string."
  (let ((v (%bytes bytes))
        (out (make-array (max 0 (- end start)) :element-type 'character
                                               :adjustable t :fill-pointer 0))
        (i start))
    (loop while (< i end)
          for b0 = (aref v i) do
            (multiple-value-bind (cp len)
                (cond
                  ((< b0 #x80) (values b0 1))
                  ((< b0 #xE0) (values (logior (ash (logand b0 #x1F) 6)
                                               (logand (aref v (+ i 1)) #x3F)) 2))
                  ((< b0 #xF0) (values (logior (ash (logand b0 #x0F) 12)
                                               (ash (logand (aref v (+ i 1)) #x3F) 6)
                                               (logand (aref v (+ i 2)) #x3F)) 3))
                  (t (values (logior (ash (logand b0 #x07) 18)
                                     (ash (logand (aref v (+ i 1)) #x3F) 12)
                                     (ash (logand (aref v (+ i 2)) #x3F) 6)
                                     (logand (aref v (+ i 3)) #x3F)) 4)))
              (vector-push-extend (code-char cp) out)
              (incf i len)))
    (coerce out 'simple-string)))

;;; ---------------------------------------------------------------------------
;;; Generic little-endian integer read (any byte width, for decimals etc.)

(defun read-uint-le (buf offset nbytes)
  (let ((b (%bytes buf)) (acc 0))
    (dotimes (i nbytes acc)
      (setf acc (logior acc (ash (aref b (+ offset i)) (* 8 i)))))))

(defun read-sint-le (buf offset nbytes)
  (let ((u (read-uint-le buf offset nbytes)) (bits (* 8 nbytes)))
    (if (logbitp (1- bits) u) (- u (ash 1 bits)) u)))

(defun %octets-slice (buf start end)
  "Fresh octet-vector holding bytes [START,END) of BUF."
  (let* ((n (- end start)) (out (make-octet-vector n)) (src (%bytes buf)))
    (dotimes (i n out) (setf (aref out i) (aref src (+ start i))))))

;;; ---------------------------------------------------------------------------
;;; ARRAY-DATA.

(defstruct (array-data (:constructor %make-array-data)
                       (:predicate array-data-p)
                       (:copier copy-array-data))
  (type nil)
  (length 0 :type fixnum)
  (raw-null-count -1 :type fixnum)      ; -1 => not yet computed
  (offset 0 :type fixnum)
  (buffers #() :type simple-vector)     ; of BUFFER or NIL
  (children #() :type simple-vector)    ; of ARRAY-DATA
  (dictionary nil))                     ; ARRAY-DATA of dictionary values

(deftype arrow-array () 'array-data)

(defun make-array-data (type length
                        &key (null-count -1) (offset 0) buffers children dictionary)
  "Construct an ARRAY-DATA.  BUFFERS/CHILDREN are sequences."
  (%make-array-data
   :type type :length length :raw-null-count null-count :offset offset
   :buffers (coerce (or buffers '()) 'simple-vector)
   :children (coerce (or children '()) 'simple-vector)
   :dictionary dictionary))

;;; Logical accessors (public names use the ARRAY- prefix).
(declaim (inline array-type array-length array-offset array-buffers
                 array-children array-dictionary))
(defun array-type (a) (array-data-type a))
(defun array-length (a) (array-data-length a))
(defun array-offset (a) (array-data-offset a))
(defun array-buffers (a) (array-data-buffers a))
(defun array-children (a) (array-data-children a))
(defun array-dictionary (a) (array-data-dictionary a))

(defun array-buffer (a i)
  (let ((bs (array-buffers a))) (when (< i (length bs)) (aref bs i))))

(defun validity-bitmap (a)
  "The validity buffer, or NIL if the type/array has none."
  (let ((ty (array-type a)))
    (unless (member (type-id ty) '(:null :union))
      (array-buffer a 0))))

(defun offsets-buffer (a)
  "The offsets buffer for binary/utf8/list/map arrays, else NIL."
  (let ((ty (array-type a)))
    (when (member (type-id ty) '(:binary :utf8 :large-binary :large-utf8
                                 :list :large-list :map))
      (array-buffer a 1))))

(defun data-buffer (a)
  "The values buffer for primitive/binary arrays."
  (let ((ty (array-type a)))
    (case (type-id ty)
      ((:binary :utf8 :large-binary :large-utf8) (array-buffer a 2))
      ((:null :list :large-list :fixed-size-list :struct :map :union) nil)
      (t (array-buffer a 1)))))

(defun array-null-count (a)
  "Number of null slots (computed and cached from the validity bitmap)."
  (let ((n (array-data-raw-null-count a)))
    (cond ((eq (type-id (array-type a)) :null) (array-length a))
          ((>= n 0) n)
          (t (let ((bm (validity-bitmap a)))
               (setf (array-data-raw-null-count a)
                     (if bm (bitmap-null-count bm (array-length a) (array-offset a)) 0)))))))

(defun array-valid-p (a i)
  "True if slot I holds a non-null value."
  (let ((ty (array-type a)))
    (cond ((eq (type-id ty) :null) nil)
          (t (let ((bm (validity-bitmap a)))
               (or (null bm) (bit-set-p bm (+ (array-offset a) i))))))))

(defun array-null-p (a i) (not (array-valid-p a i)))

;;; ---------------------------------------------------------------------------
;;; Element access.

(defun %read-fixed-int (buf phys-index byte-width signed)
  (let ((off (* phys-index byte-width)))
    (if signed (read-sint-le buf off byte-width) (read-uint-le buf off byte-width))))

(defun %read-float (buf phys-index bit-width)
  (ecase bit-width
    (16 (%bits->float (read-u16 buf (* 2 phys-index)) 10 5))
    (32 (read-f32 buf (* 4 phys-index)))
    (64 (read-f64 buf (* 8 phys-index)))))

(defun %offset-at (buf i offset-bits)
  (if (= offset-bits 64) (read-i64 buf (* 8 i)) (read-i32 buf (* 4 i))))

(defun %child (a n) (aref (array-children a) n))

(defun %range-values (child from to)
  "List of logical values of CHILD for indices [FROM,TO)."
  (loop for i from from below to collect (array-ref child i)))

(defgeneric %ref (type array phys-index)
  (:documentation "Read the logical value at physical index PHYS-INDEX."))

(defun array-ref (a i)
  "Logical value at slot I, or NIL if the slot is null."
  (if (array-null-p a i)
      nil
      (%ref (array-type a) a (+ (array-offset a) i))))

(defmethod %ref ((ty null-type) a i) (declare (ignore a i)) nil)

(defmethod %ref ((ty bool-type) a i)
  (bit-set-p (data-buffer a) i))

(defmethod %ref ((ty int-type) a i)
  (%read-fixed-int (data-buffer a) i (ceiling (int-bit-width ty) 8) (int-signed-p ty)))

(defmethod %ref ((ty floating-point-type) a i)
  (%read-float (data-buffer a) i (type-bit-width ty)))

(defmethod %ref ((ty date-type) a i)
  (%read-fixed-int (data-buffer a) i (ceiling (type-bit-width ty) 8) t))
(defmethod %ref ((ty time-type) a i)
  (%read-fixed-int (data-buffer a) i (ceiling (type-bit-width ty) 8) t))
(defmethod %ref ((ty timestamp-type) a i) (read-i64 (data-buffer a) (* 8 i)))
(defmethod %ref ((ty duration-type) a i) (read-i64 (data-buffer a) (* 8 i)))

(defmethod %ref ((ty decimal-type) a i)
  (read-sint-le (data-buffer a) (* i (ceiling (decimal-bit-width ty) 8))
                (ceiling (decimal-bit-width ty) 8)))

(defmethod %ref ((ty fixed-size-binary-type) a i)
  (let ((w (fixed-size-binary-byte-width ty)))
    (%octets-slice (data-buffer a) (* i w) (* (1+ i) w))))

(defmethod %ref ((ty binary-type) a i)   ; also large-binary via offset-bit-width
  (let* ((ob (offset-bit-width ty))
         (o (offsets-buffer a))
         (start (%offset-at o i ob))
         (end (%offset-at o (1+ i) ob)))
    (%octets-slice (data-buffer a) start end)))

(defmethod %ref ((ty utf8-type) a i)
  (let* ((ob (offset-bit-width ty))
         (o (offsets-buffer a)))
    (utf8-decode (data-buffer a) (%offset-at o i ob) (%offset-at o (1+ i) ob))))
(defmethod %ref ((ty large-utf8-type) a i)
  (let ((o (offsets-buffer a)))
    (utf8-decode (data-buffer a) (%offset-at o i 64) (%offset-at o (1+ i) 64))))

(defmethod %ref ((ty list-type) a i)     ; list and large-list
  (let* ((ob (offset-bit-width ty))
         (o (offsets-buffer a)))
    (%range-values (%child a 0) (%offset-at o i ob) (%offset-at o (1+ i) ob))))

(defmethod %ref ((ty fixed-size-list-type) a i)
  (let ((n (fixed-size-list-size ty)))
    (%range-values (%child a 0) (* i n) (* (1+ i) n))))

(defmethod %ref ((ty struct-type) a i)
  ;; child arrays are not offset-shifted independently of the parent in the
  ;; general case; struct children share the parent's logical index.
  (loop for f in (struct-fields ty)
        for c across (array-children a)
        collect (cons (field-name f) (array-ref c (- i (array-offset a))))))

(defmethod %ref ((ty map-type) a i)
  (let* ((o (offsets-buffer a))
         (entries (%child a 0))
         (start (%offset-at o i 32))
         (end (%offset-at o (1+ i) 32)))
    (loop for j from start below end
          for pair = (array-ref entries j)
          collect (cons (cdr (assoc "key" pair :test #'string=))
                        (cdr (assoc "value" pair :test #'string=))))))

(defmethod %ref ((ty dictionary-type) a i)
  (let* ((idx (%read-fixed-int (data-buffer a) i
                               (ceiling (type-bit-width (dictionary-index-type ty)) 8)
                               (int-signed-p (dictionary-index-type ty))))
         (values (array-dictionary a)))
    (array-ref values idx)))

;;; ---------------------------------------------------------------------------

(defun array-to-list (a)
  "Return the logical contents of array A as a Lisp list."
  (loop for i below (array-length a) collect (array-ref a i)))

(defmethod print-object ((a array-data) stream)
  (print-unreadable-object (a stream :type nil)
    (format stream "arrow-array ~A[~D]~:[~;, ~:*~D nulls~]"
            (type-name (array-type a)) (array-length a)
            (let ((n (ignore-errors (array-null-count a)))) (and n (plusp n) n)))))
;;; builder.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Array builders.  A builder accumulates values (and null markers) and
;;; produces an ARRAY-DATA on BUILDER-FINISH.

(in-package #:cl-arrow)

;;; ---------------------------------------------------------------------------
;;; Small mutable-vector helpers.

(defun %make-adjustable-octets (&optional (n 16))
  (make-array n :element-type 'octet :adjustable t :fill-pointer 0))

(defun push-int-le (vec value nbytes)
  "Append VALUE as NBYTES little-endian (two's-complement) octets to VEC."
  (let ((v (logand value (1- (ash 1 (* 8 nbytes))))))
    (dotimes (i nbytes)
      (vector-push-extend (logand (ash v (* -8 i)) #xff) vec))))

;;; ---------------------------------------------------------------------------
;;; Builder protocol.

(defclass builder ()
  ((type :initarg :type :reader builder-type)
   (length :initform 0 :accessor builder-length)
   (validity :initform (make-array 16 :element-type 'bit :adjustable t :fill-pointer 0)
             :accessor builder-validity)
   (any-null :initform nil :accessor builder-any-null)))

(defgeneric builder-append (builder value)
  (:documentation "Append a non-null VALUE."))
(defgeneric builder-append-null (builder)
  (:documentation "Append a null slot."))
(defgeneric builder-finish (builder)
  (:documentation "Materialize accumulated data as an ARRAY-DATA."))

(defun %mark (b valid-p)
  (vector-push-extend (if valid-p 1 0) (builder-validity b))
  (unless valid-p (setf (builder-any-null b) t))
  (incf (builder-length b)))

(defun %finish-validity (b)
  "Return a validity BUFFER if any nulls were appended, else NIL."
  (when (builder-any-null b)
    (let* ((n (builder-length b))
           (bm (make-bitmap n :initial-element 0)))
      (dotimes (i n) (when (= 1 (aref (builder-validity b) i)) (set-bit bm i)))
      (make-buffer bm))))

(defvar +na-unset+ '#:na-unset
  "Private sentinel meaning \"no NA marker supplied\".")

(defun builder-append-many (b values &key valid (na +na-unset+) (na-test #'eql))
  "Append each of VALUES, deciding nullness by exactly one rule:
 - :VALID, a parallel sequence of booleans, marks null slots explicitly
   (highest precedence); or
 - :NA, a marker value, makes elements matching it (under :NA-TEST, default
   EQL) null -- NIL is then an ordinary value, so boolean false is safe; or
 - with neither, a NIL element becomes null (convenience default)."
  (cond
    (valid
     (map nil (lambda (v ok) (if ok (builder-append b v) (builder-append-null b)))
          values valid))
    ((not (eq na +na-unset+))
     (map nil (lambda (v) (if (funcall na-test v na)
                              (builder-append-null b) (builder-append b v)))
          values))
    (t
     (map nil (lambda (v) (if (null v) (builder-append-null b) (builder-append b v)))
          values)))
  b)

(defun build-array (type values &key valid (na +na-unset+) (na-test #'eql))
  "Convenience: build an array of TYPE from a sequence of VALUES.  Null slots
are determined by :VALID / :NA / :NA-TEST as in BUILDER-APPEND-MANY."
  (let ((b (make-builder type)))
    (builder-append-many b values :valid valid :na na :na-test na-test)
    (builder-finish b)))

;;; ---------------------------------------------------------------------------
;;; NULL

(defclass null-builder (builder) ())
(defmethod builder-append ((b null-builder) value) (declare (ignore value)) (%mark b nil) b)
(defmethod builder-append-null ((b null-builder)) (%mark b nil) b)
(defmethod builder-finish ((b null-builder))
  (make-array-data (builder-type b) (builder-length b) :null-count (builder-length b)))

;;; ---------------------------------------------------------------------------
;;; BOOL (bit-packed)

(defclass bool-builder (builder)
  ((bits :initform (make-array 16 :element-type 'bit :adjustable t :fill-pointer 0)
         :accessor bb-bits)))
(defmethod builder-append ((b bool-builder) value)
  (%mark b t) (vector-push-extend (if value 1 0) (bb-bits b)) b)
(defmethod builder-append-null ((b bool-builder))
  (%mark b nil) (vector-push-extend 0 (bb-bits b)) b)
(defmethod builder-finish ((b bool-builder))
  (let* ((n (builder-length b))
         (bm (make-bitmap n :initial-element 0)))
    (dotimes (i n) (when (= 1 (aref (bb-bits b) i)) (set-bit bm i)))
    (make-array-data (builder-type b) n
                     :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                     :buffers (list (%finish-validity b) (make-buffer bm)))))

;;; ---------------------------------------------------------------------------
;;; Fixed-width primitives (int, float, temporal, decimal, fixed-size-binary)

(defclass fixed-builder (builder)
  ((byte-width :initarg :byte-width :reader fb-byte-width)
   (encoder :initarg :encoder :reader fb-encoder)   ; (value data-vector) -> ()
   (data :initform (%make-adjustable-octets) :accessor fb-data)))
(defmethod builder-append ((b fixed-builder) value)
  (%mark b t) (funcall (fb-encoder b) value (fb-data b)) b)
(defmethod builder-append-null ((b fixed-builder))
  (%mark b nil)
  (dotimes (i (fb-byte-width b)) (vector-push-extend 0 (fb-data b))) b)
(defmethod builder-finish ((b fixed-builder))
  (make-array-data (builder-type b) (builder-length b)
                   :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                   :buffers (list (%finish-validity b)
                                  (make-buffer (octet-vector-from (fb-data b))))))

(defun %int-encoder (bit-width)
  (let ((nbytes (ceiling bit-width 8)))
    (lambda (value data) (push-int-le data value nbytes))))

(defun %float-encoder (bit-width)
  (ecase bit-width
    (16 (lambda (v data) (push-int-le data (%float->bits v 10 5) 2)))
    (32 (lambda (v data) (push-int-le data (single->bits v) 4)))
    (64 (lambda (v data) (push-int-le data (double->bits v) 8)))))

(defun %fixed-binary-encoder (byte-width)
  (lambda (value data)
    (let ((ov (octet-vector-from value)))
      (dotimes (i byte-width)
        (vector-push-extend (if (< i (length ov)) (aref ov i) 0) data)))))

;;; ---------------------------------------------------------------------------
;;; Variable-length binary / utf8

(defclass var-binary-builder (builder)
  ((offset-bytes :initarg :offset-bytes :reader vb-offset-bytes)   ; 4 or 8
   (utf8 :initarg :utf8 :reader vb-utf8-p)
   (offsets :initform (make-array 16 :adjustable t :fill-pointer 0) :accessor vb-offsets)
   (data :initform (%make-adjustable-octets) :accessor vb-data)))
(defmethod initialize-instance :after ((b var-binary-builder) &key)
  (vector-push-extend 0 (vb-offsets b)))       ; leading offset
(defun %vb-last-offset (b)
  (aref (vb-offsets b) (1- (length (vb-offsets b)))))
(defmethod builder-append ((b var-binary-builder) value)
  (%mark b t)
  (let ((bytes (if (vb-utf8-p b) (utf8-encode value) (octet-vector-from value))))
    (loop for x across bytes do (vector-push-extend x (vb-data b)))
    (vector-push-extend (+ (%vb-last-offset b) (length bytes)) (vb-offsets b)))
  b)
(defmethod builder-append-null ((b var-binary-builder))
  (%mark b nil)
  (vector-push-extend (%vb-last-offset b) (vb-offsets b)) b)
(defmethod builder-finish ((b var-binary-builder))
  (let* ((ow (vb-offset-bytes b))
         (n (builder-length b))
         (obuf (make-buffer (* ow (1+ n)))))
    (dotimes (i (1+ n))
      (if (= ow 8) (write-i64 obuf (* 8 i) (aref (vb-offsets b) i))
          (write-i32 obuf (* 4 i) (aref (vb-offsets b) i))))
    (make-array-data (builder-type b) n
                     :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                     :buffers (list (%finish-validity b) obuf
                                    (make-buffer (octet-vector-from (vb-data b)))))))

;;; ---------------------------------------------------------------------------
;;; List / large-list

(defclass list-builder (builder)
  ((offset-bytes :initarg :offset-bytes :reader lb-offset-bytes)
   (child :initarg :child :reader lb-child)
   (offsets :initform (make-array 16 :adjustable t :fill-pointer 0) :accessor lb-offsets)))
(defmethod initialize-instance :after ((b list-builder) &key)
  (vector-push-extend 0 (lb-offsets b)))
(defmethod builder-append ((b list-builder) value)
  (%mark b t)
  (map nil (lambda (v) (if (null v) (builder-append-null (lb-child b))
                           (builder-append (lb-child b) v)))
       value)
  (vector-push-extend (builder-length (lb-child b)) (lb-offsets b)) b)
(defmethod builder-append-null ((b list-builder))
  (%mark b nil)
  (vector-push-extend (builder-length (lb-child b)) (lb-offsets b)) b)
(defmethod builder-finish ((b list-builder))
  (let* ((ow (lb-offset-bytes b))
         (n (builder-length b))
         (obuf (make-buffer (* ow (1+ n)))))
    (dotimes (i (1+ n))
      (if (= ow 8) (write-i64 obuf (* 8 i) (aref (lb-offsets b) i))
          (write-i32 obuf (* 4 i) (aref (lb-offsets b) i))))
    (make-array-data (builder-type b) n
                     :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                     :buffers (list (%finish-validity b) obuf)
                     :children (list (builder-finish (lb-child b))))))

;;; ---------------------------------------------------------------------------
;;; Fixed-size list

(defclass fixed-size-list-builder (builder)
  ((size :initarg :size :reader fsl-size)
   (child :initarg :child :reader fsl-child)))
(defmethod builder-append ((b fixed-size-list-builder) value)
  (%mark b t)
  (let ((n 0))
    (map nil (lambda (v) (incf n)
               (if (null v) (builder-append-null (fsl-child b))
                   (builder-append (fsl-child b) v)))
         value)
    (unless (= n (fsl-size b))
      (error "fixed-size-list element has ~D values, expected ~D" n (fsl-size b))))
  b)
(defmethod builder-append-null ((b fixed-size-list-builder))
  (%mark b nil)
  (dotimes (i (fsl-size b)) (builder-append-null (fsl-child b))) b)
(defmethod builder-finish ((b fixed-size-list-builder))
  (make-array-data (builder-type b) (builder-length b)
                   :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                   :buffers (list (%finish-validity b))
                   :children (list (builder-finish (fsl-child b)))))

;;; ---------------------------------------------------------------------------
;;; Struct

(defclass struct-builder (builder)
  ((fields :initarg :fields :reader sb-fields)
   (children :initarg :children :reader sb-children)))   ; vector of builders
(defun %struct-field-values (value fields)
  "Normalize VALUE (positional sequence or alist keyed by field name) to a
list of per-field values."
  (if (and (consp value) (consp (car value)) (stringp (caar value)))
      (mapcar (lambda (f) (cdr (assoc (field-name f) value :test #'string=))) fields)
      (coerce value 'list)))
(defmethod builder-append ((b struct-builder) value)
  (%mark b t)
  (loop for v in (%struct-field-values value (sb-fields b))
        for c across (sb-children b)
        do (if (null v) (builder-append-null c) (builder-append c v)))
  b)
(defmethod builder-append-null ((b struct-builder))
  (%mark b nil)
  (loop for c across (sb-children b) do (builder-append-null c)) b)
(defmethod builder-finish ((b struct-builder))
  (make-array-data (builder-type b) (builder-length b)
                   :null-count (if (builder-any-null b) (count 0 (builder-validity b)) 0)
                   :buffers (list (%finish-validity b))
                   :children (map 'list #'builder-finish (sb-children b))))

;;; ---------------------------------------------------------------------------
;;; Dictionary (hash-encoded)

(defclass dictionary-builder (builder)
  ((index-builder :initarg :index-builder :reader db-index-builder)
   (value-builder :initarg :value-builder :reader db-value-builder)
   (index-map :initform (make-hash-table :test 'equal) :reader db-index-map)))
(defmethod builder-append ((b dictionary-builder) value)
  (%mark b t)
  (let ((idx (gethash value (db-index-map b))))
    (unless idx
      (setf idx (hash-table-count (db-index-map b))
            (gethash value (db-index-map b)) idx)
      (builder-append (db-value-builder b) value))
    (builder-append (db-index-builder b) idx))
  b)
(defmethod builder-append-null ((b dictionary-builder))
  (%mark b nil)
  (builder-append-null (db-index-builder b)) b)
(defmethod builder-finish ((b dictionary-builder))
  (let ((indices (builder-finish (db-index-builder b)))
        (values (builder-finish (db-value-builder b))))
    (make-array-data (builder-type b) (array-length indices)
                     :null-count (array-null-count indices)
                     :buffers (coerce (array-buffers indices) 'list)
                     :dictionary values)))

;;; ---------------------------------------------------------------------------
;;; Dispatch.

(defun make-builder (type)
  "Create a builder appropriate for data TYPE."
  (ecase (type-id type)
    (:null (make-instance 'null-builder :type type))
    (:bool (make-instance 'bool-builder :type type))
    (:int (make-instance 'fixed-builder :type type
                         :byte-width (ceiling (int-bit-width type) 8)
                         :encoder (%int-encoder (int-bit-width type))))
    (:floating-point (make-instance 'fixed-builder :type type
                                    :byte-width (ceiling (type-bit-width type) 8)
                                    :encoder (%float-encoder (type-bit-width type))))
    ((:date :time) (make-instance 'fixed-builder :type type
                                  :byte-width (ceiling (type-bit-width type) 8)
                                  :encoder (%int-encoder (type-bit-width type))))
    ((:timestamp :duration) (make-instance 'fixed-builder :type type
                                           :byte-width 8 :encoder (%int-encoder 64)))
    (:decimal (make-instance 'fixed-builder :type type
                             :byte-width (ceiling (decimal-bit-width type) 8)
                             :encoder (%int-encoder (decimal-bit-width type))))
    (:fixed-size-binary
     (let ((w (fixed-size-binary-byte-width type)))
       (make-instance 'fixed-builder :type type :byte-width w
                      :encoder (%fixed-binary-encoder w))))
    ((:utf8 :large-utf8)
     (make-instance 'var-binary-builder :type type :utf8 t
                    :offset-bytes (ceiling (offset-bit-width type) 8)))
    ((:binary :large-binary)
     (make-instance 'var-binary-builder :type type :utf8 nil
                    :offset-bytes (ceiling (offset-bit-width type) 8)))
    ((:list :large-list)
     (make-instance 'list-builder :type type
                    :offset-bytes (ceiling (offset-bit-width type) 8)
                    :child (make-builder (field-type (list-value-field type)))))
    (:fixed-size-list
     (make-instance 'fixed-size-list-builder :type type
                    :size (fixed-size-list-size type)
                    :child (make-builder (field-type (list-value-field type)))))
    (:struct
     (make-instance 'struct-builder :type type
                    :fields (struct-fields type)
                    :children (map 'vector (lambda (f) (make-builder (field-type f)))
                                   (struct-fields type))))
    (:dictionary
     (make-instance 'dictionary-builder :type type
                    :index-builder (make-builder (dictionary-index-type type))
                    :value-builder (make-builder (dictionary-value-type type))))))
;;; record-batch.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; A RECORD-BATCH is a collection of equal-length columnar arrays with a
;;; schema.  A TABLE generalizes this to columns made of multiple chunks.

(in-package #:cl-arrow)

(defstruct (record-batch (:constructor %make-record-batch) (:predicate record-batch-p)
                         (:conc-name batch-))
  (schema nil)
  (columns #() :type simple-vector))

(defun make-record-batch (schema columns)
  "Build a record batch from SCHEMA and a sequence of COLUMNS (arrays).
Signals an error if column count/lengths disagree with the schema."
  (let* ((cols (coerce columns 'simple-vector))
         (fields (schema-fields schema)))
    (unless (= (length cols) (length fields))
      (error "record-batch: ~D columns but schema has ~D fields"
             (length cols) (length fields)))
    (let ((nrows (if (plusp (length cols)) (array-length (aref cols 0)) 0)))
      (loop for c across cols for f in fields for i from 0 do
        (unless (= (array-length c) nrows)
          (error "record-batch: column ~D length ~D /= ~D" i (array-length c) nrows))
        (unless (type-equal (array-type c) (field-type f))
          (error "record-batch: column ~D type ~A /= field type ~A"
                 i (type-name (array-type c)) (type-name (field-type f))))))
    (%make-record-batch :schema schema :columns cols)))

(defun batch-num-columns (batch) (length (batch-columns batch)))
(defun batch-num-rows (batch)
  (if (plusp (batch-num-columns batch)) (array-length (aref (batch-columns batch) 0)) 0))
(defun batch-column (batch i) (aref (batch-columns batch) i))
(defun batch-column-by-name (batch name)
  (let ((i (schema-field-index (batch-schema batch) name)))
    (and i (aref (batch-columns batch) i))))

(defmethod print-object ((b record-batch) stream)
  (print-unreadable-object (b stream :type t)
    (format stream "~D cols x ~D rows" (batch-num-columns b) (batch-num-rows b))))

;;; ---------------------------------------------------------------------------
;;; Chunked arrays and tables.

(defstruct (chunked-array (:constructor %make-chunked-array) (:predicate chunked-array-p))
  (type nil)
  (chunks '() :type list))

(defun make-chunked-array (chunks &optional type)
  "A logical array formed by concatenating CHUNKS (arrays of the same type)."
  (let ((chunks (coerce chunks 'list)))
    (%make-chunked-array
     :type (or type (and chunks (array-type (first chunks))))
     :chunks chunks)))

(defun chunked-array-length (ca)
  (reduce #'+ (chunked-array-chunks ca) :key #'array-length :initial-value 0))

(defun chunked-array-ref (ca i)
  "Logical element I across all chunks (or NIL if null)."
  (loop for chunk in (chunked-array-chunks ca)
        for len = (array-length chunk)
        if (< i len) return (array-ref chunk i)
        else do (decf i len)))

(defstruct (arrow-table (:constructor %make-table) (:predicate arrow-table-p)
                        (:conc-name table-))
  (schema nil)
  (columns #() :type simple-vector))    ; of CHUNKED-ARRAY

(defun make-table (schema columns)
  "Build a table from SCHEMA and a sequence of chunked-array COLUMNS."
  (%make-table :schema schema :columns (coerce columns 'simple-vector)))

(defun table-from-batches (schema batches)
  "Assemble a TABLE from a sequence of record BATCHES sharing SCHEMA."
  (let* ((batches (coerce batches 'list))
         (ncol (length (schema-fields schema))))
    (make-table schema
                (loop for j below ncol
                      collect (make-chunked-array
                               (mapcar (lambda (b) (batch-column b j)) batches)
                               (field-type (nth j (schema-fields schema))))))))

(defun table-num-columns (table) (length (table-columns table)))
(defun table-num-rows (table)
  (if (plusp (table-num-columns table))
      (chunked-array-length (aref (table-columns table) 0)) 0))
(defun table-column (table i-or-name)
  (etypecase i-or-name
    (integer (aref (table-columns table) i-or-name))
    (string (let ((i (schema-field-index (table-schema table) i-or-name)))
              (and i (aref (table-columns table) i))))))

(defmethod print-object ((tbl arrow-table) stream)
  (print-unreadable-object (tbl stream :type t)
    (format stream "~D cols x ~D rows" (table-num-columns tbl) (table-num-rows tbl))))
;;; flatbuffers.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; A minimal, dependency-free FlatBuffers writer and reader, sufficient for
;;; Apache Arrow's IPC metadata (Message, Schema, RecordBatch, Footer).
;;;
;;; FlatBuffers are little-endian.  A builder writes back-to-front: values are
;;; appended toward decreasing addresses, so the finished message is the tail
;;; of the working buffer.  Offsets are measured as "distance from the end".

(in-package #:cl-arrow)

;;; ===========================================================================
;;; Builder

(defstruct (fbb (:constructor %make-fbb))
  (buf (make-octet-vector 1024) :type octet-vector)
  (head 1024 :type fixnum)              ; index of current front; data in [head,cap)
  (minalign 1 :type fixnum)
  (vtable nil)                          ; simple-vector of field offsets, or nil
  (object-end 0 :type fixnum)
  (finished nil))

(defun make-fbb (&optional (size 1024)) (%make-fbb :buf (make-octet-vector size) :head size))

(declaim (inline fbb-offset))
(defun fbb-offset (b) (- (length (fbb-buf b)) (fbb-head b)))

(defun %fbb-grow (b)
  (let* ((old (fbb-buf b)) (oldcap (length old))
         (newcap (* 2 oldcap)) (delta (- newcap oldcap))
         (new (make-octet-vector newcap)))
    (replace new old :start1 (+ (fbb-head b) delta) :start2 (fbb-head b) :end2 oldcap)
    (setf (fbb-buf b) new (fbb-head b) (+ (fbb-head b) delta))))

(defun %fbb-place (b value nbytes)
  "Write VALUE as NBYTES little-endian octets just below HEAD."
  (decf (fbb-head b) nbytes)
  (let ((buf (fbb-buf b)) (h (fbb-head b))
        (v (logand value (1- (ash 1 (* 8 nbytes))))))
    (dotimes (i nbytes) (setf (aref buf (+ h i)) (logand (ash v (* -8 i)) #xff)))))

(defun fbb-prep (b size additional)
  "Ensure the next write of SIZE bytes (after ADDITIONAL bytes) is aligned."
  (when (> size (fbb-minalign b)) (setf (fbb-minalign b) size))
  (let ((align (logand (- (+ (fbb-offset b) additional)) (1- size))))
    (loop while (< (fbb-head b) (+ align size additional)) do (%fbb-grow b))
    (dotimes (i align) (%fbb-place b 0 1))))

(macrolet ((defprep (name nbytes)
             `(defun ,name (b x) (fbb-prep b ,nbytes 0) (%fbb-place b x ,nbytes))))
  (defprep fbb-prepend-u8 1)
  (defprep fbb-prepend-u16 2)
  (defprep fbb-prepend-i32 4)
  (defprep fbb-prepend-u32 4)
  (defprep fbb-prepend-i64 8)
  (defprep fbb-prepend-u64 8))
(defun fbb-prepend-bool (b x) (fbb-prepend-u8 b (if x 1 0)))

(defun fbb-prepend-uoffset (b off)
  "Prepend a relative uoffset pointing at absolute (end-relative) OFF."
  (fbb-prep b 4 0)
  (%fbb-place b (+ (- (fbb-offset b) off) 4) 4))

;;; --- strings / byte vectors -------------------------------------------------

(defun fbb-create-string (b string)
  (let* ((x (utf8-encode string)) (l (length x)))
    (fbb-prep b 4 (1+ l))
    (%fbb-place b 0 1)                   ; null terminator
    (decf (fbb-head b) l)
    (replace (fbb-buf b) x :start1 (fbb-head b))
    (%fbb-place b l 4)
    (fbb-offset b)))

(defun fbb-create-bytes (b octets)
  (let ((l (length octets)))
    (fbb-prep b 4 l)
    (decf (fbb-head b) l)
    (replace (fbb-buf b) (octet-vector-from octets) :start1 (fbb-head b))
    (%fbb-place b l 4)
    (fbb-offset b)))

;;; --- vectors ----------------------------------------------------------------

(defun fbb-start-vector (b elem-size n align)
  (fbb-prep b 4 (* elem-size n))
  (fbb-prep b align (* elem-size n)))
(defun fbb-end-vector (b n) (%fbb-place b n 4) (fbb-offset b))

(defun fbb-create-offset-vector (b offsets)
  "Vector of table/string offsets (a list of end-relative offsets)."
  (let ((n (length offsets)))
    (fbb-start-vector b 4 n 4)
    (dolist (o (reverse offsets)) (fbb-prepend-uoffset b o))
    (fbb-end-vector b n)))

(defun fbb-create-i32-vector (b ints)
  (let ((n (length ints)))
    (fbb-start-vector b 4 n 4)
    (dolist (x (reverse (coerce ints 'list))) (fbb-prepend-i32 b x))
    (fbb-end-vector b n)))

;;; --- tables -----------------------------------------------------------------

(defun fbb-start-object (b numfields)
  (setf (fbb-vtable b) (make-array numfields :initial-element 0)
        (fbb-object-end b) (fbb-offset b)))

(defun fbb-slot (b field-index)
  (setf (aref (fbb-vtable b) field-index) (fbb-offset b)))

(defun fbb-add-i32 (b i value &optional (default 0))
  (unless (eql value default) (fbb-prepend-i32 b value) (fbb-slot b i)))
(defun fbb-add-i64 (b i value &optional (default 0))
  (unless (eql value default) (fbb-prepend-i64 b value) (fbb-slot b i)))
(defun fbb-add-u16 (b i value &optional (default 0))
  (unless (eql value default) (fbb-prepend-u16 b value) (fbb-slot b i)))
(defun fbb-add-u8 (b i value &optional (default 0))
  (unless (eql value default) (fbb-prepend-u8 b value) (fbb-slot b i)))
(defun fbb-add-bool (b i value &optional (default nil))
  (unless (eq (and value t) default) (fbb-prepend-bool b value) (fbb-slot b i)))
(defun fbb-add-offset (b i off)
  (when (and off (/= off 0)) (fbb-prepend-uoffset b off) (fbb-slot b i)))

(defun fbb-end-object (b)
  (fbb-prepend-i32 b 0)                  ; soffset placeholder
  (let* ((object-offset (fbb-offset b))
         (vt (fbb-vtable b))
         (trimmed (length vt)))
    (loop while (and (> trimmed 0) (zerop (aref vt (1- trimmed)))) do (decf trimmed))
    (loop for i from (1- trimmed) downto 0
          for slot = (aref vt i)
          do (fbb-prepend-u16 b (if (zerop slot) 0 (- object-offset slot))))
    (fbb-prepend-u16 b (- object-offset (fbb-object-end b)))  ; object size
    (fbb-prepend-u16 b (* (+ trimmed 2) 2))                   ; vtable size
    (write-i32 (fbb-buf b) (- (length (fbb-buf b)) object-offset)
               (- (fbb-offset b) object-offset))              ; patch soffset
    (setf (fbb-vtable b) nil)
    object-offset))

(defun fbb-finish (b root &key file-identifier)
  (fbb-prep b (fbb-minalign b) (if file-identifier 8 4))
  (when file-identifier
    (loop for i from 3 downto 0 do (%fbb-place b (char-code (char file-identifier i)) 1)))
  (fbb-prepend-uoffset b root)
  (setf (fbb-finished b) t)
  b)

(defun fbb-bytes (b)
  "The finished message as a fresh octet-vector."
  (subseq (fbb-buf b) (fbb-head b)))

;;; ===========================================================================
;;; Reader.  All functions take a raw octet-vector plus absolute positions.

(declaim (inline fb-indirect))
(defun fb-indirect (buf pos) (+ pos (read-u32 buf pos)))

(defun fb-root (buf &optional (base 0)) (fb-indirect buf base))

(defun fb-field-pos (buf table voffset)
  "Absolute position of the field at VOFFSET in TABLE, or NIL if absent."
  (let* ((vt (- table (read-i32 buf table)))
         (vtsize (read-u16 buf vt)))
    (when (< voffset vtsize)
      (let ((o (read-u16 buf (+ vt voffset))))
        (when (/= o 0) (+ table o))))))

(defun fb-scalar (buf table voffset reader default)
  (let ((p (fb-field-pos buf table voffset)))
    (if p (funcall reader buf p) default)))

(defun fb-bool (buf table voffset &optional default)
  (let ((p (fb-field-pos buf table voffset)))
    (if p (/= 0 (read-u8 buf p)) default)))

(defun fb-offset-field (buf table voffset)
  "Position of the object referenced by the offset field at VOFFSET, or NIL."
  (let ((p (fb-field-pos buf table voffset)))
    (when p (fb-indirect buf p))))

(defun fb-string-at (buf pos)
  (let ((len (read-u32 buf pos)))
    (utf8-decode buf (+ pos 4) (+ pos 4 len))))

(defun fb-string-field (buf table voffset)
  (let ((p (fb-offset-field buf table voffset))) (when p (fb-string-at buf p))))

(defun fb-vector-field (buf table voffset)
  "Position of the vector (its length prefix), or NIL."
  (fb-offset-field buf table voffset))

(declaim (inline fb-vector-len fb-vector-elem))
(defun fb-vector-len (buf vec) (read-u32 buf vec))
(defun fb-vector-elem (vec i elem-size) (+ vec 4 (* i elem-size)))

(defun fb-vector-offset-elem (buf vec i)
  "Indirected subtable/string at element I of an offset vector."
  (let ((ep (fb-vector-elem vec i 4))) (fb-indirect buf ep)))
;;; ipc-metadata.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Encoding and decoding of Arrow's IPC metadata FlatBuffers (Message,
;;; Schema, Field, Type, RecordBatch, Footer) on top of flatbuffers.lisp.
;;; Field indices / voffsets below follow Arrow's Message.fbs, Schema.fbs and
;;; File.fbs verbatim.

(in-package #:cl-arrow)

(defconstant +metadata-version-v5+ 4)

;; MessageHeader union
(defconstant +mh-schema+ 1)
(defconstant +mh-dictionary-batch+ 2)
(defconstant +mh-record-batch+ 3)

;; Type union tags
(defparameter *type-tags*
  '((:null . 1) (:int . 2) (:floating-point . 3) (:binary . 4) (:utf8 . 5)
    (:bool . 6) (:decimal . 7) (:date . 8) (:time . 9) (:timestamp . 10)
    (:interval . 11) (:list . 12) (:struct . 13) (:union . 14)
    (:fixed-size-binary . 15) (:fixed-size-list . 16) (:map . 17)
    (:duration . 18) (:large-binary . 19) (:large-utf8 . 20) (:large-list . 21)))
(defun type-tag (id) (or (cdr (assoc id *type-tags*)) (error "unsupported type ~A" id)))
(defun tag-type (tag) (car (rassoc tag *type-tags*)))

(defun %time-unit-code (u) (ecase u (:second 0) (:millisecond 1) (:microsecond 2) (:nanosecond 3)))
(defun %code-time-unit (c) (ecase c (0 :second) (1 :millisecond) (2 :microsecond) (3 :nanosecond)))
(defun %precision-code (p) (ecase p (:half 0) (:single 1) (:double 2)))
(defun %code-precision (c) (ecase c (0 :half) (1 :single) (2 :double)))

;;; ===========================================================================
;;; Type encoding.  Returns the offset of the Type union table.

(defun %empty-table (b)
  (fbb-start-object b 0) (fbb-end-object b))

(defun encode-type (b type)
  (ecase (type-id type)
    ((:null :binary :utf8 :bool :list :struct :large-binary :large-utf8 :large-list)
     (%empty-table b))
    (:int (fbb-start-object b 2)
          (fbb-add-i32 b 0 (int-bit-width type))
          (fbb-add-bool b 1 (int-signed-p type))
          (fbb-end-object b))
    (:floating-point (fbb-start-object b 1)
                     (fbb-add-u16 b 0 (%precision-code (floating-point-precision type)) -1)
                     (fbb-end-object b))
    (:decimal (fbb-start-object b 3)
              (fbb-add-i32 b 0 (decimal-precision type))
              (fbb-add-i32 b 1 (decimal-scale type))
              (fbb-add-i32 b 2 (decimal-bit-width type) 128)
              (fbb-end-object b))
    (:date (fbb-start-object b 1)
           (fbb-add-u16 b 0 (ecase (date-unit type) (:day 0) (:millisecond 1)) -1)
           (fbb-end-object b))
    (:time (fbb-start-object b 2)
           (fbb-add-u16 b 0 (%time-unit-code (time-unit type)) -1)
           (fbb-add-i32 b 1 (time-bit-width type) 32)
           (fbb-end-object b))
    (:timestamp (let ((tz (and (timestamp-timezone type)
                               (fbb-create-string b (timestamp-timezone type)))))
                  (fbb-start-object b 2)
                  (fbb-add-u16 b 0 (%time-unit-code (timestamp-unit type)) -1)
                  (fbb-add-offset b 1 tz)
                  (fbb-end-object b)))
    (:duration (fbb-start-object b 1)
               (fbb-add-u16 b 0 (%time-unit-code (duration-unit type)) -1)
               (fbb-end-object b))
    (:fixed-size-binary (fbb-start-object b 1)
                        (fbb-add-i32 b 0 (fixed-size-binary-byte-width type))
                        (fbb-end-object b))
    (:fixed-size-list (fbb-start-object b 1)
                      (fbb-add-i32 b 0 (fixed-size-list-size type))
                      (fbb-end-object b))
    (:map (fbb-start-object b 1)
          (fbb-add-bool b 0 (map-keys-sorted-p type))
          (fbb-end-object b))
    (:union (let ((ids (fbb-create-i32-vector b (union-type-ids type))))
              (fbb-start-object b 2)
              (fbb-add-u16 b 0 (ecase (union-mode type) (:sparse 0) (:dense 1)) -1)
              (fbb-add-offset b 1 ids)
              (fbb-end-object b)))))

;;; ===========================================================================
;;; Dictionary bookkeeping.

(defvar *dict-ids* nil
  "During schema encoding, a hash-table mapping dictionary-encoded FIELDs to
their assigned dictionary ids.")

(defun %dict-id (field) (and *dict-ids* (gethash field *dict-ids*)))

(defun schema-dictionary-plan (schema)
  "List of plists (:id :field :column :value-type) for top-level
dictionary-encoded fields, ids assigned 0,1,... in field order."
  (let ((plan '()) (id 0))
    (loop for f in (schema-fields schema) for i from 0
          when (typep (field-type f) 'dictionary-type)
            do (push (list :id id :field f :column i
                           :value-type (dictionary-value-type (field-type f)))
                     plan)
               (incf id))
    (nreverse plan)))

(defun %encode-dictionary-encoding (b id index-type ordered)
  ;; DictionaryEncoding{ id:long v4, indexType:Int v6, isOrdered:bool v8 }
  (let ((it (encode-type b index-type)))    ; index-type is an int-type -> Int table
    (fbb-start-object b 4)
    (fbb-add-i64 b 0 id 0)
    (fbb-add-offset b 1 it)
    (fbb-add-bool b 2 ordered)
    (fbb-end-object b)))

;;; ===========================================================================
;;; Field / Schema encoding.

(defun encode-field (b field)
  (let* ((ftype (field-type field))
         (dict (when (typep ftype 'dictionary-type) ftype))
         ;; A dictionary field is serialized with its VALUE type; the index
         ;; type travels inside the DictionaryEncoding.
         (vtype (if dict (dictionary-value-type ftype) ftype))
         (name (fbb-create-string b (field-name field)))
         (child-offsets (mapcar (lambda (f) (encode-field b f)) (type-children vtype)))
         (children (when child-offsets (fbb-create-offset-vector b child-offsets)))
         (type-off (encode-type b vtype))
         (dict-off (when dict
                     (%encode-dictionary-encoding
                      b (or (%dict-id field) 0)
                      (dictionary-index-type ftype) (dictionary-ordered-p ftype)))))
    (fbb-start-object b 7)
    (fbb-add-offset b 0 name)
    (fbb-add-bool b 1 (field-nullable field))
    (fbb-add-u8 b 2 (type-tag (type-id vtype)))
    (fbb-add-offset b 3 type-off)
    (fbb-add-offset b 4 dict-off)          ; Field.dictionary (voffset 12)
    (fbb-add-offset b 5 children)
    (fbb-end-object b)))

(defun encode-schema (b schema)
  (let* ((field-offsets (mapcar (lambda (f) (encode-field b f)) (schema-fields schema)))
         (fields (fbb-create-offset-vector b field-offsets)))
    (fbb-start-object b 4)
    ;; endianness voffset4 defaults to Little(0); fields voffset6
    (fbb-add-offset b 1 fields)
    (fbb-end-object b)))

;;; ===========================================================================
;;; Message wrapping.

(defun %build-message (b header-tag header-offset body-length)
  (fbb-start-object b 5)
  (fbb-add-u16 b 0 +metadata-version-v5+ 0)
  (fbb-add-u8 b 1 header-tag)
  (fbb-add-offset b 2 header-offset)
  (fbb-add-i64 b 3 body-length 0)
  (fbb-end-object b))

(defun encode-schema-message (schema)
  "A complete Message flatbuffer (octet-vector) carrying SCHEMA.  Dictionary
ids are assigned deterministically (see SCHEMA-DICTIONARY-PLAN)."
  (let ((*dict-ids* (make-hash-table :test 'eq)))
    (dolist (p (schema-dictionary-plan schema))
      (setf (gethash (getf p :field) *dict-ids*) (getf p :id)))
    (let* ((b (make-fbb))
           (s (encode-schema b schema))
           (m (%build-message b +mh-schema+ s 0)))
      (fbb-finish b m)
      (fbb-bytes b))))

;;; RecordBatch metadata.  NODES is a list of (length . null-count); BUFFERS a
;;; list of (offset . length).

(defun %encode-fieldnodes (b nodes)
  (let ((n (length nodes)))
    (fbb-start-vector b 16 n 8)
    (dolist (nd (reverse nodes))
      (fbb-prepend-i64 b (cdr nd))       ; null_count (high)
      (fbb-prepend-i64 b (car nd)))      ; length (low)
    (fbb-end-vector b n)))

(defun %encode-buffers (b buffers)
  (let ((n (length buffers)))
    (fbb-start-vector b 16 n 8)
    (dolist (bf (reverse buffers))
      (fbb-prepend-i64 b (cdr bf))       ; length (high)
      (fbb-prepend-i64 b (car bf)))      ; offset (low)
    (fbb-end-vector b n)))

(defun encode-record-batch (b length nodes buffers)
  (let ((nodes-vec (%encode-fieldnodes b nodes))
        (bufs-vec (%encode-buffers b buffers)))
    (fbb-start-object b 5)
    (fbb-add-i64 b 0 length 0)
    (fbb-add-offset b 1 nodes-vec)
    (fbb-add-offset b 2 bufs-vec)
    (fbb-end-object b)))

(defun encode-record-batch-message (length nodes buffers body-length)
  "A complete Message flatbuffer (octet-vector) for a record batch."
  (let* ((b (make-fbb))
         (rb (encode-record-batch b length nodes buffers))
         (m (%build-message b +mh-record-batch+ rb body-length)))
    (fbb-finish b m)
    (fbb-bytes b)))

(defun encode-dictionary-batch-message (id length nodes buffers body-length
                                        &optional is-delta)
  "A complete Message flatbuffer (octet-vector) for a DictionaryBatch that
defines dictionary ID from an inner record batch (its values array)."
  (let* ((b (make-fbb))
         (rb (encode-record-batch b length nodes buffers))
         (db (progn (fbb-start-object b 3)   ; DictionaryBatch{ id, data, isDelta }
                    (fbb-add-i64 b 0 id 0)
                    (fbb-add-offset b 1 rb)
                    (fbb-add-bool b 2 is-delta)
                    (fbb-end-object b)))
         (m (%build-message b +mh-dictionary-batch+ db body-length)))
    (fbb-finish b m)
    (fbb-bytes b)))

;;; ===========================================================================
;;; File footer.  BLOCKS are lists of (offset meta-length body-length).

(defun %encode-blocks (b blocks)
  (let ((n (length blocks)))
    (fbb-start-vector b 24 n 8)
    (dolist (blk (reverse blocks))
      (destructuring-bind (offset meta body) blk
        (fbb-prepend-i64 b body)         ; bytes 16..23
        (fbb-prepend-i32 b 0)            ; padding 12..15
        (fbb-prepend-i32 b meta)         ; bytes 8..11
        (fbb-prepend-i64 b offset)))     ; bytes 0..7
    (fbb-end-vector b n)))

(defun encode-footer (schema dictionaries record-batches)
  "A complete Footer flatbuffer (octet-vector)."
  (let* ((b (make-fbb))
         (s (encode-schema b schema))
         (dicts (%encode-blocks b dictionaries))
         (rbs (%encode-blocks b record-batches)))
    (fbb-start-object b 5)
    (fbb-add-u16 b 0 +metadata-version-v5+ 0)
    (fbb-add-offset b 1 s)
    (fbb-add-offset b 2 dicts)
    (fbb-add-offset b 3 rbs)
    (fbb-finish b (fbb-end-object b))
    (fbb-bytes b)))

;;; ===========================================================================
;;; Decoding.

(defun decode-type (buf type-tag type-table children)
  "Reconstruct a data-type from its union TAG, TYPE-TABLE position, and
already-decoded CHILDREN fields."
  (ecase (tag-type type-tag)
    (:null *null*) (:bool *bool*)
    (:binary *binary*) (:utf8 *utf8*)
    (:large-binary *large-binary*) (:large-utf8 *large-utf8*)
    (:int (int-type (fb-scalar buf type-table 4 #'read-i32 0)
                    :signed (fb-bool buf type-table 6)))
    (:floating-point (floating-point-type
                      (%code-precision (fb-scalar buf type-table 4 #'read-u16 0))))
    (:decimal (decimal-type (fb-scalar buf type-table 4 #'read-i32 0)
                            (fb-scalar buf type-table 6 #'read-i32 0)
                            :bit-width (fb-scalar buf type-table 8 #'read-i32 128)))
    (:date (date-type (ecase (fb-scalar buf type-table 4 #'read-u16 1) (0 :day) (1 :millisecond))))
    (:time (time-type (%code-time-unit (fb-scalar buf type-table 4 #'read-u16 1))
                      (fb-scalar buf type-table 6 #'read-i32 32)))
    (:timestamp (timestamp-type (%code-time-unit (fb-scalar buf type-table 4 #'read-u16 0))
                                :timezone (fb-string-field buf type-table 6)))
    (:duration (duration-type (%code-time-unit (fb-scalar buf type-table 4 #'read-u16 1))))
    (:fixed-size-binary (fixed-size-binary-type (fb-scalar buf type-table 4 #'read-i32 0)))
    (:fixed-size-list (fixed-size-list-type (field-type (first children))
                                            (fb-scalar buf type-table 4 #'read-i32 0)
                                            :name (field-name (first children))
                                            :nullable (field-nullable (first children))))
    (:list (make-instance 'list-type :value-field (first children)))
    (:large-list (make-instance 'large-list-type :value-field (first children)))
    (:struct (struct-type children))
    (:map (make-instance 'map-type :entries-field (first children)
                         :keys-sorted (fb-bool buf type-table 4)))
    (:union (union-type children
                        :mode (ecase (fb-scalar buf type-table 4 #'read-u16 0) (0 :sparse) (1 :dense))
                        :type-ids (let ((v (fb-vector-field buf type-table 6)))
                                    (when v (loop for i below (fb-vector-len buf v)
                                                  collect (read-i32 buf (fb-vector-elem v i 4)))))))))

(defun %decode-dictionary-encoding (buf dict-table value-type)
  "Reconstruct a DICTIONARY-TYPE from a DictionaryEncoding table and the
field's VALUE-TYPE, carrying the dictionary id."
  (let* ((id (fb-scalar buf dict-table 4 #'read-i64 0))
         (it-pos (fb-offset-field buf dict-table 6))
         (index-type (if it-pos (decode-type buf (type-tag :int) it-pos nil) *int32*))
         (ordered (fb-bool buf dict-table 8))
         (dt (dictionary-type index-type value-type :ordered ordered)))
    (setf (dictionary-type-id dt) id)
    dt))

(defun decode-field (buf field-table)
  (let* ((name (or (fb-string-field buf field-table 4) ""))
         (nullable (fb-bool buf field-table 6))
         (type-tag (fb-scalar buf field-table 8 #'read-u8 0))
         (type-table (fb-offset-field buf field-table 10))
         (dict-table (fb-offset-field buf field-table 12))
         (children-vec (fb-vector-field buf field-table 14))
         (children (when children-vec
                     (loop for i below (fb-vector-len buf children-vec)
                           collect (decode-field buf (fb-vector-offset-elem buf children-vec i)))))
         (value-type (decode-type buf type-tag type-table children))
         (type (if dict-table
                   (%decode-dictionary-encoding buf dict-table value-type)
                   value-type)))
    (make-field name type :nullable nullable)))

(defun decode-schema (buf schema-table)
  (let ((fields-vec (fb-vector-field buf schema-table 6)))
    (make-schema (when fields-vec
                   (loop for i below (fb-vector-len buf fields-vec)
                         collect (decode-field buf (fb-vector-offset-elem buf fields-vec i)))))))

(defstruct (ipc-message (:constructor %make-ipc-message))
  version header-tag header-pos body-length)

(defun decode-message (buf &optional (base 0))
  "Decode a Message flatbuffer header from BUF at BASE."
  (let ((table (fb-root buf base)))
    (%make-ipc-message
     :version (fb-scalar buf table 4 #'read-u16 0)
     :header-tag (fb-scalar buf table 6 #'read-u8 0)
     :header-pos (fb-offset-field buf table 8)
     :body-length (fb-scalar buf table 10 #'read-i64 0))))

(defun decode-record-batch (buf rb-table)
  "Return (values length nodes buffers), where NODES is a list of
(length . null-count) and BUFFERS a list of (offset . length)."
  (let* ((length (fb-scalar buf rb-table 4 #'read-i64 0))
         (nodes-vec (fb-vector-field buf rb-table 6))
         (bufs-vec (fb-vector-field buf rb-table 8))
         (nodes (when nodes-vec
                  (loop for i below (fb-vector-len buf nodes-vec)
                        for p = (fb-vector-elem nodes-vec i 16)
                        collect (cons (read-i64 buf p) (read-i64 buf (+ p 8))))))
         (buffers (when bufs-vec
                    (loop for i below (fb-vector-len buf bufs-vec)
                          for p = (fb-vector-elem bufs-vec i 16)
                          collect (cons (read-i64 buf p) (read-i64 buf (+ p 8)))))))
    (values length nodes buffers)))

(defun decode-dictionary-batch (buf db-table)
  "Return (values id rb-table is-delta) for a DictionaryBatch header."
  (values (fb-scalar buf db-table 4 #'read-i64 0)
          (fb-offset-field buf db-table 6)
          (fb-bool buf db-table 8)))

(defun decode-footer (buf)
  "Return (values schema dictionary-blocks record-batch-blocks), where each
block is a list (offset meta-length body-length)."
  (let* ((table (fb-root buf))
         (schema-table (fb-offset-field buf table 6)))
    (flet ((blocks (voffset)
             (let ((v (fb-vector-field buf table voffset)))
               (when v (loop for i below (fb-vector-len buf v)
                             for p = (fb-vector-elem v i 24)
                             collect (list (read-i64 buf p) (read-i32 buf (+ p 8))
                                           (read-i64 buf (+ p 16))))))))
      (values (decode-schema buf schema-table) (blocks 8) (blocks 10)))))
;;; ipc.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Arrow IPC: encapsulated message framing, the streaming format, and the
;;; random-access file format.  Arrays are flattened to a body of 8-byte
;;; aligned buffers described by FieldNodes + Buffers in the RecordBatch
;;; metadata, following a depth-first pre-order traversal of each column.

(in-package #:cl-arrow)

(defparameter +arrow-magic+
  (octet-vector-from '(#x41 #x52 #x52 #x4f #x57 #x31)) ; "ARROW1"
  "Arrow file magic.")

;;; ---------------------------------------------------------------------------
;;; Raw output helpers on an adjustable octet vector.

(defun %push-bytes (out bytes)
  (loop for x across bytes do (vector-push-extend x out)))
(defun %push-u32 (out v)
  (dotimes (i 4) (vector-push-extend (logand (ash v (* -8 i)) #xff) out)))
(defun %push-i32 (out v) (%push-u32 out (logand v #xffffffff)))
(defun %pad-to-8 (out)
  (loop until (zerop (mod (fill-pointer out) 8)) do (vector-push-extend 0 out)))

;;; ---------------------------------------------------------------------------
;;; Flattening arrays to buffers + field nodes.

(defun %buffer-bytes (buf)
  (cond ((null buf) (make-octet-vector 0))
        ((= (buffer-length buf) (length (buffer-bytes buf))) (buffer-bytes buf))
        (t (subseq (buffer-bytes buf) 0 (buffer-length buf)))))

(defun %flatten-array (array nodes buffers)
  "Append ARRAY's field node and buffer byte-vectors (pre-order) to the
adjustable accumulators NODES and BUFFERS."
  (vector-push-extend (cons (array-length array) (array-null-count array)) nodes)
  (let ((bs (array-buffers array)) (nb (type-num-buffers (array-type array))))
    (dotimes (i nb)
      (vector-push-extend (%buffer-bytes (when (< i (length bs)) (aref bs i))) buffers)))
  (loop for c across (array-children array) do (%flatten-array c nodes buffers)))

(defun %flatten-arrays (arrays)
  "Return (values body-octets nodes buffer-metas) for a sequence of ARRAYS
laid out as one IPC body (8-byte aligned buffers, pre-order field nodes)."
  (let ((nodes (make-array 8 :adjustable t :fill-pointer 0))
        (bufbytes (make-array 8 :adjustable t :fill-pointer 0)))
    (loop for a in (coerce arrays 'list) do (%flatten-array a nodes bufbytes))
    (let ((body (%make-adjustable-octets 64))
          (metas '()))
      (loop for bytes across bufbytes do
        (let ((offset (fill-pointer body)))
          (%push-bytes body bytes)
          (push (cons offset (length bytes)) metas)
          (%pad-to-8 body)))
      (values (octet-vector-from body) (coerce nodes 'list) (nreverse metas)))))

(defun %encode-batch-body (batch)
  "Body, field nodes, and buffer metas for a record BATCH."
  (%flatten-arrays (coerce (batch-columns batch) 'list)))

;;; ---------------------------------------------------------------------------
;;; Encapsulated message framing.

(defun %write-encapsulated (out metadata body)
  "Write <0xFFFFFFFF><metadata-size><metadata+pad><body> to OUT.  Returns
(values start-offset metadata-length body-length)."
  (let ((start (fill-pointer out))
        (mlen (align-up (length metadata) 8)))
    (%push-u32 out #xFFFFFFFF)
    (%push-i32 out mlen)
    (%push-bytes out metadata)
    (dotimes (i (- mlen (length metadata))) (vector-push-extend 0 out))
    (when body (%push-bytes out body))
    (values start (+ 8 mlen) (if body (length body) 0))))

(defun %read-message (bytes pos)
  "Read one encapsulated message from BYTES at POS.  Returns
(values ipc-message metadata-octets body-octets new-pos); IPC-MESSAGE is NIL
at end-of-stream."
  (if (> (+ pos 4) (length bytes))
      (values nil nil nil pos)
      (let ((w (read-u32 bytes pos)) (p pos) (mlen nil))
        (cond ((= w #xFFFFFFFF) (setf p (+ pos 4) mlen (read-i32 bytes p) p (+ p 4)))
              (t (setf mlen w p (+ pos 4))))
        (if (or (null mlen) (zerop mlen))
            (values nil nil nil p)
            (let* ((metadata (subseq bytes p (+ p mlen)))
                   (msg (decode-message metadata))
                   (p2 (+ p mlen))
                   (blen (ipc-message-body-length msg))
                   (body (when (> blen 0) (subseq bytes p2 (+ p2 blen)))))
              (values msg metadata body (+ p2 blen)))))))

;;; ---------------------------------------------------------------------------
;;; Reconstructing arrays from a body + field nodes + buffers.

(defun reconstruct-array (type nodes buffers body node-cursor buf-cursor
                          &optional dictionaries)
  "Rebuild one array of TYPE, consuming pre-order NODES/BUFFERS via the
fixnum cursors (each a 1-element list used as a mutable box).  DICTIONARIES,
if given, is a hash id->values-array used to resolve dictionary columns."
  (flet ((make-buf (meta)
           (destructuring-bind (off . len) meta
             (when (> len 0) (make-buffer (%octets-slice body off (+ off len)))))))
    (let* ((node (aref nodes (car node-cursor)))
           (nb (type-num-buffers type))
           (bufs (loop repeat nb
                       collect (make-buf (aref buffers (car buf-cursor)))
                       do (incf (car buf-cursor)))))
      (incf (car node-cursor))
      (let ((children (loop for f in (type-children type)
                            collect (reconstruct-array (field-type f) nodes buffers body
                                                       node-cursor buf-cursor dictionaries))))
        (make-array-data type (car node) :null-count (cdr node)
                         :buffers bufs :children children
                         :dictionary (when (typep type 'dictionary-type)
                                       (and dictionaries
                                            (gethash (dictionary-type-id type) dictionaries))))))))

(defun reconstruct-record-batch (schema length nodes buffers body &optional dictionaries)
  (declare (ignore length))
  (let ((nodes (coerce nodes 'vector))
        (buffers (coerce buffers 'vector))
        (node-cursor (list 0)) (buf-cursor (list 0)))
    (make-record-batch
     schema (mapcar (lambda (f)
                      (reconstruct-array (field-type f) nodes buffers body
                                         node-cursor buf-cursor dictionaries))
                    (schema-fields schema)))))

(defun reconstruct-dictionary-values (value-type nodes buffers body)
  "Rebuild the single values array of a DictionaryBatch's inner record batch."
  (reconstruct-array value-type (coerce nodes 'vector) (coerce buffers 'vector)
                     body (list 0) (list 0)))

;;; ---------------------------------------------------------------------------
;;; Streaming format -- incremental writer.

(defun %encapsulate (metadata body)
  "Framed encapsulated message bytes for METADATA (+ optional BODY)."
  (let ((out (%make-adjustable-octets (+ 16 (length metadata) (if body (length body) 0)))))
    (%write-encapsulated out metadata body)
    (octet-vector-from out)))

(defun %batch-message (batch)
  "Framed record-batch message bytes for BATCH (metadata + body), O(batch)."
  (multiple-value-bind (body nodes metas) (%encode-batch-body batch)
    (%encapsulate
     (encode-record-batch-message (batch-num-rows batch) nodes metas (length body)) body)))

(defun %dictionary-message (id values-array &optional is-delta)
  "Framed DictionaryBatch message bytes defining dictionary ID from
VALUES-ARRAY (the array of distinct dictionary values)."
  (multiple-value-bind (body nodes metas) (%flatten-arrays (list values-array))
    (%encapsulate
     (encode-dictionary-batch-message id (array-length values-array) nodes metas
                                      (length body) is-delta)
     body)))

(defstruct (stream-writer (:constructor %make-stream-writer))
  emit schema plan (finished nil))

(defun %sink-emitter (sink)
  "Normalize SINK (an octet callback or a binary output stream) to a function
of one octet-vector."
  (etypecase sink
    (function sink)
    (stream (lambda (octets) (write-sequence octets sink)))))

(defun open-stream-writer (schema sink)
  "Begin an Arrow IPC stream to SINK (a binary output stream or a function
called with each octet-vector chunk), emitting the schema message now.
Feed batches with STREAM-WRITE-BATCH and end with STREAM-FINISH."
  (let ((emit (%sink-emitter sink)))
    (funcall emit (%encapsulate (encode-schema-message schema) nil))
    (%make-stream-writer :emit emit :schema schema
                         :plan (schema-dictionary-plan schema))))

(defun stream-write-batch (writer batch)
  "Encode and flush one record BATCH to WRITER's sink (O(batch) memory).  Each
dictionary-encoded column's dictionary is (re)sent before the batch as a
DictionaryBatch, so batches carrying independent dictionaries are correct
(Arrow stream dictionary replacement)."
  (dolist (p (stream-writer-plan writer))
    (let ((values (array-dictionary (batch-column batch (getf p :column)))))
      (funcall (stream-writer-emit writer) (%dictionary-message (getf p :id) values))))
  (funcall (stream-writer-emit writer) (%batch-message batch))
  writer)

(defun stream-finish (writer)
  "Emit the end-of-stream marker."
  (let ((eos (%make-adjustable-octets 8)))
    (%push-u32 eos #xFFFFFFFF) (%push-i32 eos 0)
    (funcall (stream-writer-emit writer) (octet-vector-from eos))
    (setf (stream-writer-finished writer) t)
    writer))

(defun write-ipc-stream (schema batches)
  "Serialize SCHEMA and record BATCHES to an Arrow IPC stream (octet-vector)."
  (let* ((out (%make-adjustable-octets 256))
         (w (open-stream-writer schema (lambda (oct) (%push-bytes out oct)))))
    (dolist (batch (coerce batches 'list)) (stream-write-batch w batch))
    (stream-finish w)
    (octet-vector-from out)))

(defun columns->record-batch (columns &key metadata)
  "Build a record batch from generic COLUMNS, each a list
  (NAME TYPE VECTOR &key VALID NA NA-TEST NULLABLE).
NAME may be a string or symbol; TYPE is a data-type; VECTOR is any sequence.
Returns the record batch (its schema is on BATCH-SCHEMA)."
  (let ((fields '()) (arrays '()))
    (dolist (col columns)
      (destructuring-bind (name type vector &rest opts) col
        (push (make-field (string name) type :nullable (getf opts :nullable t)) fields)
        (remf opts :nullable)
        (push (apply #'build-array type vector opts) arrays)))
    (let ((schema (make-schema (nreverse fields) :metadata metadata)))
      (make-record-batch schema (nreverse arrays)))))

(defun columns->ipc-stream (columns &key metadata)
  "Turn generic COLUMNS (see COLUMNS->RECORD-BATCH) into a complete Arrow IPC
stream (octet-vector) in one call."
  (let ((batch (columns->record-batch columns :metadata metadata)))
    (write-ipc-stream (batch-schema batch) (list batch))))

;;; Streaming format -- incremental reader.

(defstruct (stream-reader (:constructor %make-stream-reader))
  source (pos 0) schema
  (dictionaries (make-hash-table))      ; id -> values array
  (dict-types (make-hash-table)))       ; id -> value-type

(defun open-stream-reader (source)
  "Begin reading an Arrow IPC stream from SOURCE (an octet-vector or a binary
input stream).  Pull messages one at a time with STREAM-READ-MESSAGE."
  (%make-stream-reader :source source))

(defun %index-dictionary-types (reader schema)
  (clrhash (stream-reader-dict-types reader))
  (dolist (f (schema-fields schema))
    (when (typep (field-type f) 'dictionary-type)
      (setf (gethash (dictionary-type-id (field-type f)) (stream-reader-dict-types reader))
            (dictionary-value-type (field-type f))))))

(defun %read-n (in n)
  "Read exactly N bytes from binary stream IN, or NIL on EOF/short read."
  (let* ((v (make-octet-vector n)) (got (read-sequence v in)))
    (when (= got n) v)))

(defun %next-stream-message (in)
  "Read one framed message from binary stream IN.  Returns
(values ipc-message metadata body), all NIL at end-of-stream."
  (let ((prefix (%read-n in 4)))
    (if (null prefix)
        (values nil nil nil)
        (let ((w (read-u32 prefix 0)) (mlen nil))
          (if (= w #xFFFFFFFF)
              (let ((sz (%read-n in 4))) (setf mlen (and sz (read-i32 sz 0))))
              (setf mlen w))
          (if (or (null mlen) (zerop mlen))
              (values nil nil nil)
              (let* ((metadata (%read-n in mlen))
                     (msg (decode-message metadata))
                     (blen (ipc-message-body-length msg))
                     (body (when (> blen 0) (%read-n in blen))))
                (values msg metadata body)))))))

(defun %next-message (reader)
  (etypecase (stream-reader-source reader)
    (stream (%next-stream-message (stream-reader-source reader)))
    (array (multiple-value-bind (m md bd np)
               (%read-message (stream-reader-source reader) (stream-reader-pos reader))
             (setf (stream-reader-pos reader) np)
             (values m md bd)))))

(defun %absorb-dictionary-batch (reader metadata body header-pos)
  "Reconstruct a dictionary's values and store them by id."
  (multiple-value-bind (id rb-table) (decode-dictionary-batch metadata header-pos)
    (let ((value-type (gethash id (stream-reader-dict-types reader))))
      (when value-type
        (multiple-value-bind (len nodes bufs) (decode-record-batch metadata rb-table)
          (declare (ignore len))
          (setf (gethash id (stream-reader-dictionaries reader))
                (reconstruct-dictionary-values value-type nodes bufs body)))))))

(defun stream-read-message (reader)
  "Read the next data message.  DictionaryBatch messages are consumed
internally.  Returns (values KIND OBJECT): KIND is :schema, :record-batch, or
:eof.  Record batches have their dictionary columns resolved."
  (loop
    (multiple-value-bind (msg metadata body) (%next-message reader)
      (when (null msg) (return (values :eof nil)))
      (let ((tag (ipc-message-header-tag msg)) (hp (ipc-message-header-pos msg)))
        (cond
          ((= tag +mh-schema+)
           (setf (stream-reader-schema reader) (decode-schema metadata hp))
           (%index-dictionary-types reader (stream-reader-schema reader))
           (return (values :schema (stream-reader-schema reader))))
          ((= tag +mh-dictionary-batch+)
           (%absorb-dictionary-batch reader metadata body hp))   ; loop for next
          ((= tag +mh-record-batch+)
           (multiple-value-bind (len nodes bufs) (decode-record-batch metadata hp)
             (return (values :record-batch
                             (reconstruct-record-batch (stream-reader-schema reader)
                                                       len nodes bufs body
                                                       (stream-reader-dictionaries reader))))))
          (t nil))))))

(defun read-ipc-stream (bytes)
  "Parse an entire Arrow IPC stream.  Returns (values schema batches)."
  (let ((r (open-stream-reader bytes)) (schema nil) (batches '()))
    (loop
      (multiple-value-bind (kind obj) (stream-read-message r)
        (case kind
          (:eof (return))
          (:schema (setf schema obj))
          (:record-batch (push obj batches)))))
    (values schema (nreverse batches))))

;;; ---------------------------------------------------------------------------
;;; File (random-access) format.

(defun %write-block (out framed)
  "Append a pre-framed message FRAMED to OUT; return its (offset meta body)
block, where offset is the message start and meta-length includes the 8-byte
encapsulation prefix."
  (let ((start (fill-pointer out)))
    (%push-bytes out framed)
    ;; The framed bytes are 8(prefix)+padded-metadata+body; recover meta/body
    ;; split from the size field.
    (let* ((mlen (read-i32 framed 4))
           (meta-len (+ 8 mlen))
           (body-len (- (length framed) meta-len)))
      (list start meta-len body-len))))

(defun write-ipc-file (schema batches)
  "Serialize SCHEMA and record BATCHES to an Arrow IPC file (octet-vector)."
  (let ((out (%make-adjustable-octets 256))
        (batches (coerce batches 'list))
        (plan (schema-dictionary-plan schema))
        (dict-blocks '()) (rb-blocks '()))
    (when (and plan (> (length batches) 1))
      ;; The file format forbids dictionary replacement; multiple batches would
      ;; all have to share one dictionary.  Use the stream format instead.
      (error "write-ipc-file: dictionary columns with multiple record batches ~
are not supported; use the stream format (write-ipc-stream)."))
    (%push-bytes out +arrow-magic+) (%pad-to-8 out)     ; "ARROW1" + pad to 8
    ;; The file embeds a full stream: schema, dictionaries, batches, then EOS.
    (%write-encapsulated out (encode-schema-message schema) nil)
    (when (and plan batches)
      (dolist (p plan)
        (let ((values (array-dictionary (batch-column (first batches) (getf p :column)))))
          (push (%write-block out (%dictionary-message (getf p :id) values)) dict-blocks))))
    (dolist (batch batches)
      (push (%write-block out (%batch-message batch)) rb-blocks))
    (%push-u32 out #xFFFFFFFF) (%push-i32 out 0)         ; end-of-stream
    (let ((footer (encode-footer schema (nreverse dict-blocks) (nreverse rb-blocks))))
      (%push-bytes out footer)
      (%push-i32 out (length footer))
      (%push-bytes out +arrow-magic+))
    (octet-vector-from out)))

(defun read-ipc-file (bytes)
  "Parse an Arrow IPC file.  Returns (values schema list-of-record-batches)."
  (let* ((n (length bytes))
         (footer-len (read-i32 bytes (- n 6 4)))
         (footer (subseq bytes (- n 6 4 footer-len) (- n 6 4))))
    (multiple-value-bind (schema dict-blocks rb-blocks) (decode-footer footer)
      (let ((dict-types (make-hash-table))
            (dictionaries (make-hash-table)))
        (dolist (f (schema-fields schema))
          (when (typep (field-type f) 'dictionary-type)
            (setf (gethash (dictionary-type-id (field-type f)) dict-types)
                  (dictionary-value-type (field-type f)))))
        ;; resolve dictionaries first, then the record batches that use them
        (loop for (offset) in dict-blocks do
          (multiple-value-bind (msg metadata bodybytes) (%read-message bytes offset)
            (multiple-value-bind (id rb-table)
                (decode-dictionary-batch metadata (ipc-message-header-pos msg))
              (let ((vt (gethash id dict-types)))
                (when vt
                  (multiple-value-bind (len nodes bufs) (decode-record-batch metadata rb-table)
                    (declare (ignore len))
                    (setf (gethash id dictionaries)
                          (reconstruct-dictionary-values vt nodes bufs bodybytes))))))))
        (values schema
                (loop for (offset) in rb-blocks
                      collect (multiple-value-bind (msg metadata bodybytes)
                                  (%read-message bytes offset)
                                (multiple-value-bind (len nodes bufs)
                                    (decode-record-batch metadata (ipc-message-header-pos msg))
                                  (reconstruct-record-batch schema len nodes bufs bodybytes
                                                            dictionaries)))))))))

(defun read-ipc-file-as-table (bytes)
  "Parse an Arrow IPC file into a TABLE."
  (multiple-value-bind (schema batches) (read-ipc-file bytes)
    (table-from-batches schema batches)))

;;; ---------------------------------------------------------------------------
;;; Convenience file I/O (zero-dependency, via standard streams).

(defun read-file-octets (path)
  (with-open-file (in path :element-type 'octet)
    (let ((v (make-octet-vector (file-length in))))
      (read-sequence v in)
      v)))

(defun write-file-octets (path octets)
  (with-open-file (out path :element-type 'octet :direction :output
                            :if-exists :supersede :if-does-not-exist :create)
    (write-sequence octets out))
  path)

(defun write-arrow-file (path schema batches)
  "Write an Arrow IPC file to PATH."
  (write-file-octets path (write-ipc-file schema batches)))

(defun read-arrow-file (path)
  "Read an Arrow IPC file from PATH.  Returns (values schema batches)."
  (read-ipc-file (read-file-octets path)))

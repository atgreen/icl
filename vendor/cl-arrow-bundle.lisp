;;;
;;; The Arrow logical type system.  Every type reports its physical buffer
;;; layout so that arrays, builders and IPC can be written generically:
;;;
;;;   TYPE-NUM-BUFFERS  number of physical buffers (incl. validity)
;;;   TYPE-CHILDREN     child FIELDs, for nested types
;;;   FIXED-WIDTH-P     T for primitive fixed-size-per-element types
;;;   TYPE-BIT-WIDTH    bits per element for fixed-width types
;;;   OFFSET-BIT-WIDTH  32 or 64 for variable-size / list types, else NIL

(in-package #:cl-arrow)

;;; ---------------------------------------------------------------------------
;;; FIELD -- defined here because nested types hold their children as fields.

(defstruct (field (:constructor %make-field) (:copier nil) (:predicate field-p))
  (name "" :type string)
  (type nil)
  (nullable t)
  (metadata nil))                       ; list of (key-string . value-string)

(defun make-field (name type &key (nullable t) metadata)
  "Construct a FIELD wrapping data TYPE."
  (%make-field :name (string name) :type type
               :nullable (and nullable t) :metadata metadata))

(declaim (inline field-nullable-p))
(defun field-nullable-p (field) (field-nullable field))

;;; ---------------------------------------------------------------------------
;;; Base protocol.

(defclass data-type () ()
  (:documentation "Abstract base of every Arrow logical type."))

(defun data-type-p (x) (typep x 'data-type))

(defgeneric type-id (type)
  (:documentation "A keyword identifying the type family, e.g. :INT."))
(defgeneric type-name (type)
  (:documentation "A human-readable name, e.g. \"int32\"."))
(defgeneric type-num-buffers (type)
  (:documentation "Number of physical buffers an array of TYPE has."))

(defgeneric type-children (type)
  (:method ((type data-type)) '()))
(defgeneric fixed-width-p (type)
  (:method ((type data-type)) nil))
(defgeneric type-bit-width (type)
  (:method ((type data-type)) nil))
(defgeneric offset-bit-width (type)
  (:method ((type data-type)) nil))

(defgeneric type-equal (a b)
  (:documentation "Structural type equality.")
  (:method (a b) (eq a b))
  (:method ((a data-type) (b data-type))
    (eq (class-of a) (class-of b))))

(defun field-equal (a b)
  (and (string= (field-name a) (field-name b))
       (eq (field-nullable a) (field-nullable b))
       (type-equal (field-type a) (field-type b))))

(defun fields-equal (as bs)
  (and (= (length as) (length bs))
       (every #'field-equal as bs)))

(defmethod print-object ((ty data-type) stream)
  (print-unreadable-object (ty stream :type nil)
    (write-string (type-name ty) stream)))

(defun field-children (field) (type-children (field-type field)))


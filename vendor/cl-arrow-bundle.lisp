(declaim (inline align-up))
(defun align-up (n &optional (alignment 8))
  "Round N up to the next multiple of ALIGNMENT (Arrow uses 8-byte
alignment for IPC bodies; 64 is recommended for allocations)."
  (* alignment (ceiling n alignment)))
;;; bitmap.lisp
;;;
;;; SPDX-License-Identifier: MIT
;;;
;;; Copyright (C) 2026 Anthony Green
;;;
;;; Validity (null) bitmaps.  Arrow packs one bit per slot, LSB-first within
;;; each byte: slot i lives in byte i/8, at bit i%8 (bit 0 = least
;;; significant).  A set bit (1) means "valid / not null".

(in-package #:cl-arrow)

(declaim (inline bitmap-byte-length))
(defun bitmap-byte-length (n-bits)
  "Number of bytes needed to hold N-BITS bits."
  (ceiling n-bits 8))

(defun make-bitmap (n-bits &key (initial-element 1))
  "Allocate a validity bitmap for N-BITS slots.  INITIAL-ELEMENT is the bit
value (0 or 1) every slot starts at; default 1 (all valid)."
  (make-octet-vector (bitmap-byte-length n-bits)
                     :initial-element (if (zerop initial-element) #x00 #xff)))

(declaim (inline bit-set-p))
(defun bit-set-p (bytes i)
  "True if bit I is set (slot I is valid)."
  (logbitp (logand i 7) (aref (%bytes bytes) (ash i -3))))

(declaim (inline set-bit))
(defun set-bit (bytes i)
  (let ((v (%bytes bytes)) (byte (ash i -3)))
    (setf (aref v byte) (logior (aref v byte) (ash 1 (logand i 7))))))

(declaim (inline clear-bit))
(defun clear-bit (bytes i)
  (let ((v (%bytes bytes)) (byte (ash i -3)))
    (setf (aref v byte) (logand (aref v byte) (lognot (ash 1 (logand i 7)))))))

(declaim (inline set-bit-to))
(defun set-bit-to (bytes i value)
  (if (and value (not (eql value 0))) (set-bit bytes i) (clear-bit bytes i)))

(defparameter +popcount-table+
  (let ((tbl (make-array 256 :element-type '(unsigned-byte 8))))
    (dotimes (i 256 tbl)
      (setf (aref tbl i) (logcount i)))))

(defun bitmap-popcount (bytes n-bits &optional (offset 0))
  "Count set bits in the first N-BITS slots starting at slot OFFSET."
  (let ((v (%bytes bytes)) (count 0))
    (declare (type fixnum count))
    (if (zerop (logand offset 7))
        ;; byte-aligned fast path
        (let ((full-bytes (ash n-bits -3))
              (start (ash offset -3)))
          (dotimes (i full-bytes)
            (incf count (aref +popcount-table+ (aref v (+ start i)))))
          (loop for b from (* full-bytes 8) below n-bits
                when (bit-set-p v (+ offset b)) do (incf count)))
        (dotimes (i n-bits)
          (when (bit-set-p v (+ offset i)) (incf count))))
    count))

(defun bitmap-null-count (bytes n-bits &optional (offset 0))
  "Number of unset (null) bits among the first N-BITS slots from OFFSET."
  (- n-bits (bitmap-popcount bytes n-bits offset)))
